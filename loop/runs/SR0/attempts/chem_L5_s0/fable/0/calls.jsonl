{"t": 1795076937.084127, "tool": "analyze", "code": "from scipy.optimize import least_squares\ny=dA_dt\ncands={\n'expinv':(lambda p:p[0]+p[1]*A+p[2]*A**p[3]*np.exp(-p[4]/A**p[5]),[[0.93,-5.86,9,1,.6,2],[0.93,-5.86,9,1,1,1],[0.93,-5.86,9,2,.6,2],[0.93,-5.86,5,1.5,.6,1.5]]),\n'expinv_nolin':(lambda p:p[0]+p[1]*A+p[2]*A**2+p[3]*np.exp(-p[4]/A**p[5]),[[0.93,-5.86,1,9,.6,2],[0.93,-5.86,0,9,1,1]]),\n'sigm_inv':(lambda p:p[0]+p[1]*A+p[2]*A**p[3]/(1+np.exp(p[4]/A**p[5]-p[6])),[[0.93,-5.86,9,1,.6,2,0],[0.93,-5.86,9,1,2,1,1]]),\n'softplus':(lambda p:p[0]+p[1]*A+p[2]*np.log1p(np.exp(p[3]*A**p[5]-p[4])),[[0.93,-5.86,3,3,3,1],[0.93,-5.86,9,1,3,2],[0.93,-5.86,9,3,3,.5]]),\n'tanhpow':(lambda p:p[0]+p[1]*A+p[2]*A**p[3]*np.tanh(p[4]*A**p[5]),[[0.93,-5.86,9,1,1,4],[0.93,-5.86,9,1,1,6],[0.93,-5.86,9,0.5,1,8]]),\n'gaussA':(lambda p:p[0]+p[1]*A+p[2]*A**p[3]*(1-np.exp(-p[4]*A**p[5])),[[0.93,-5.86,9,1,1,4],[0.93,-5.86,9,1,1,8],[0.93,-5.86,9,0,1,6]]),\n'hillhi':(lambda p:p[0]+p[1]*A+p[2]*A**p[3]/(1+p[4]*A**(-p[5]))**p[6],[[0.93,-5.86,9,1,1,4,1],[0.93,-5.86,9,1,.2,8,1],[0.93,-5.86,9,1,1,6,.5]]),\n}\nfor n,(f,starts) in cands.items():\n    best=1e9\n    for p0 in starts:\n        try:\n            r=least_squares(lambda p:f(p)-y,p0,xtol=1e-15,ftol=1e-15,gtol=1e-15,max_nfev=5000)\n            v=np.mean(r.fun**2)/np.var(y)\n            if v<best:best=v;bp=r.x\n        except Exception as e: print(e)\n    print(n,best,bp)", "out": "expinv 3.164074663923037e-06 [ 9.76016107e-01 -6.10318761e+00  1.00295695e+06 -1.01984019e+00\n  1.34886661e+01  2.75139262e-01]\nexpinv_nolin 1.561651519770372e-05 [-9.87614386e-01  4.56991957e+01 -1.30555071e+00 -7.62168122e+04\n  7.38802810e+00  1.30399608e-01]\nsigm_inv 3.9861033362058047e-07 [ 1.01071019e+00 -6.23711436e+00  1.36841274e+03 -4.63580109e-01\n  1.03270552e+01  2.97511066e-01  3.50677948e+00]\nsoftplus 2.8803251856030726e-07 [-301.68045331 -122.91457062  171.81219208    0.78861166   -1.57063872\n    0.97390657]\ntanhpow 8.409533666019946e-06 [ 1.189