{"t": 1795077003.0671074, "tool": "analyze", "code": "from scipy.optimize import least_squares\nimport time\ny=dA_dt; lg=np.log(A); sq=np.sqrt(A)\ndef pw(p): return np.exp(np.clip(p,-8,8)*lg)\ncands={\n'pow+rat':(lambda p:p[0]*pw(p[1])+p[2]*pw(p[3])/(1+p[4]**2*pw(p[5])),6),\n'pow+powexp':(lambda p:p[0]*pw(p[1])+p[2]*pw(p[3])*np.exp(-p[4]**2*pw(p[5])),6),\n'pow+sin':(lambda p:p[0]*pw(p[1])+p[2]*np.sin(p[3]*pw(p[4])+p[5]),6),\n'lin+sinsq':(lambda p:p[0]*A+p[1]*sq+p[2]*np.sin(p[3]*sq)+p[4]*A**2+p[5],6),\n'coslog':(lambda p:p[0]*pw(p[1])+p[2]*np.cos(p[3]*np.log(A+1)+p[5])+p[4],6),\n'rat4':(lambda p:p[0]*A+p[1]*A**2+p[2]*A**2/(1+p[3]**2*A**4)+p[4]*sq+p[5],6),\n'powsin':(lambda p:p[0]*pw(p[1])+p[2]*pw(p[3])*np.sin(p[4]*A+p[5]),6),\n'expsq':(lambda p:p[0]*pw(p[1])+p[2]*pw(p[3])*np.exp(-p[4]**2*sq)+p[5],6),\n'tanh':(lambda p:p[0]*pw(p[1])+p[2]*np.tanh(p[3]*pw(p[4]))+p[5]*A,6),\n'log':(lambda p:p[0]*pw(p[1])+p[2]*np.log1p(p[3]**2*pw(p[4]))+p[5]*A,6),\n}\nrng=np.random.default_rng(3)\nt0=time.time()\nfor n,(f,k) in cands.items():\n    best=1e9;ts=time.time()\n    while time.time()-ts<1.7:\n        p0=rng.normal(0,1.5,k)\n        try:\n            r=least_squares(lambda p:f(p)-y,p0,max_nfev=300)\n            v=np.mean(r.fun**2)/np.var(y)\n            if v<best:best=v;bp=r.x\n        except Exception as e: pass\n    print(n,'%.3g'%best,np.round(bp,4))", "out": "pow+rat 1.6e-06 [   9.7435    0.4827 -101.2944   -0.8489   -2.5527   -1.5832]\npow+powexp 1.52e-23 [  5.1      0.5    -13.8      1.       0.6678   1.    ]\npow+sin 0.0001 [ 0.      8.0103  4.3585 -1.5161  0.6645  0.4921]\nlin+sinsq 1.82e-06 [-28.3338  56.7277  32.3193  -1.3898   0.8393  -1.1782]\ncoslog 5.44e-06 [ 1.5868  1.0026  4.8831 -2.0119 -2.4265  5.4718]\nrat4 0.00012 [-3.9311  1.0751  0.7013  0.071  -3.8571  2.3025]\npowsin 5.91e-05 [-39.6068   0.7296  52.0385   0.5982  -0.1364   2.5172]\nexpsq 1.63e-05 [-9.2171  1.1735 11.4155  2.3726 -0.9691  1.0249]\ntanh 3.95e-06 [ 3.921017e+02 -6.000000e-04 -3.916770e+02  3.