{"t": 1795076846.5648243, "tool": "analyze", "code": "from scipy.optimize import least_squares\ny=dA_dt\no=np.argsort(A);As=A[o];ys=y[o]\n# local derivative by windows\nfor i in range(0,290,15):\n    c=np.polyfit(As[i:i+10],ys[i:i+10],2);m=As[i:i+10].mean()\n    print(round(m,3),round(np.polyval(c,m),4),round(2*c[0]*m+c[1],3),round(2*c[0],2))\ncands={\n'hill':lambda p:p[0]+p[1]*A+p[2]*A**p[3]/(1+np.abs(p[4])*A**p[5]),\n'gauss':lambda p:p[0]+p[1]*A+p[2]*A**p[5]*np.exp(-np.abs(p[3])*A**p[4]),\n'tanh':lambda p:p[0]+p[1]*A+p[2]*np.tanh(p[3]*A+p[4])+p[5]*A**2,\n'sinpow':lambda p:p[0]+p[1]*A+p[2]*np.sin(p[3]*A**p[4]+p[5]),\n'exppow':lambda p:p[0]+p[1]*A**p[2]+p[3]*np.exp(p[4]*A)+p[5]*A,\n}\nrng=np.random.default_rng(1)\nfor n,f in cands.items():\n    best=1e9\n    for i in range(60):\n        p0=rng.normal(0,1.5,6)\n        try:\n            r=least_squares(lambda p:f(p)-y,p0)\n            v=np.mean(r.fun**2)/np.var(y)\n            if v<best:best=v;bp=r.x\n        except Exception as e: pass\n    print(n,best,bp)", "out": "0.261 -0.6025 -5.851 0.41\n0.368 -1.2154 -5.583 4.09\n0.595 -2.3652 -4.466 5.42\n0.827 -3.2555 -3.218 5.25\n0.96 -3.6371 -2.541 4.91\n1.195 -4.1029 -1.449 4.34\n1.33 -4.2601 -0.892 3.92\n1.558 -4.3659 -0.06 3.38\n1.737 -4.3249 0.501 2.94\n1.922 -4.1844 1.003 2.49\n2.182 -3.8449 1.585 2.02\n2.425 -3.4046 2.019 1.56\n2.647 -2.9216 2.331 1.28\n2.813 -2.517 2.522 1.03\n3.025 -1.9617 2.716 0.79\n3.154 -1.605 2.81 0.67\n3.308 -1.1652 2.902 0.52\n3.54 -0.4771 3.002 0.34\n3.682 -0.0475 3.044 0.24\n3.908 0.645 3.084 0.14\nhill 4.090505675941975e-06 [ 1.12864259 -6.95581605  2.48916015  2.44350599 -0.18777054  1.57463437]\ngauss 5.413960911851153e-07 [  0.81930714   1.6524145  -11.99032336   0.65864619   0.91522343\n   1.24785011]\ntanh 6.456316511588973e-06 [  9.47126855   4.10435915 -23.94767798   0.54492074   0.3611756\n  -0.08141975]\nsinpow 4.4212220990958756e-07 [-3.15577112  1.25061188  3.44529499 -2.93618624  0.41880652  2.37622062]\nexppow 1.147163864287