{"t": 1795074731.746665, "tool": "analyze", "code": "import numpy as np\nbest=[]\nfor n in np.arange(0.2,2.01,0.05):\n  for nn in [1]:\n    f=eps**n\n    for basis_name,X in [\n      ('1,T,f,Tf', np.c_[np.ones_like(T),T,f,T*f]),\n      ('T,f,Tf,T2f', np.c_[T,f,T*f,T**2*f]),\n      ('1,T,T2,f,Tf,T2f', np.c_[np.ones_like(T),T,T**2,f,T*f,T**2*f]),\n      ('T,T2,f,Tf,T2f,', np.c_[T,T**2,f,T*f,T**2*f]),\n    ]:\n        c,*_=np.linalg.lstsq(X,sigma,rcond=None)\n        best.append((np.mean((sigma-X@c)**2)/np.var(sigma),n,basis_name,np.round(c,3)))\nbest.sort(key=lambda x:x[0])\nfor b in best[:6]: print(b)\n", "out": "(np.float64(0.008872321442607141), np.float64(1.9999999999999996), '1,T,T2,f,Tf,T2f', array([ 1.375,  2.372, -0.103, -0.209,  0.021,  0.012]))\n(np.float64(0.009257507023190946), np.float64(1.9499999999999995), '1,T,T2,f,Tf,T2f', array([ 1.426,  2.358, -0.103, -0.228,  0.024,  0.012]))\n(np.float64(0.009384587994637265), np.float64(1.9999999999999996), 'T,T2,f,Tf,T2f,', array([ 3.091, -0.19 , -0.122, -0.024,  0.017]))\n(np.float64(0.009676065430261817), np.float64(1.8999999999999997), '1,T,T2,f,Tf,T2f', array([ 1.479,  2.343, -0.103, -0.25 ,  0.027,  0.013]))\n(np.float64(0.009799363474176129), np.float64(1.9499999999999995), 'T,T2,f,Tf,T2f,', array([ 3.103, -0.193, -0.131, -0.027,  0.019]))\n(np.float64(0.010058418616641885), np.float64(1.9999999999999996), '1,T,f,Tf', array([ 2.874,  1.551, -0.38 ,  0.114]))\n"}
