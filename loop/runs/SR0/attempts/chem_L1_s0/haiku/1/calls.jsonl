{"t": 1795074349.196337, "tool": "analyze", "code": "import itertools\ndef fit(cols,names):\n    X=np.column_stack(cols)\n    c,_,_,_=np.linalg.lstsq(X,dA_dt,rcond=None)\n    r=np.mean((X@c-dA_dt)**2)/np.var(dA_dt)\n    return r,c\nph={'1':np.ones_like(t),'t':t,'t2':t**2,'t3':t**3}\nps={'1/A':1/A,'1':np.ones_like(A),'A':A}\ncols=[];names=[]\nfor a in ph:\n    for b in ps:\n        cols.append(ph[a]*ps[b]); names.append(a+'*'+b)\nr,c=fit(cols,names)\nprint(r)\nfor n,v in zip(names,c): print(n, round(v,4))", "out": "9.660316798301165e-24\n1*1/A 2.57\n1*1 0.0\n1*A -0.0\nt*1/A -0.0\nt*1 0.0\nt*A -0.0\nt2*1/A 0.0\nt2*1 -0.0\nt2*A 0.0\nt3*1/A -0.0\nt3*1 0.0091\nt3*A -0.0\n"}
