{"t": 1795076698.819396, "tool": "analyze", "code": "import numpy as np\nfrom scipy.optimize import minimize_scalar\ns=np.sqrt(t)\ndef nm(extra):\n    A=np.c_[[t**1.5,s*P**3]+extra].T\n    c=np.linalg.lstsq(A,dP_dt,rcond=None)[0];r=dP_dt-A@c\n    return np.var(r)/np.var(dP_dt),c\nshapes={\n 'P/(h+P)':lambda h:P/(h+P),\n 'P2/(h2+P2)':lambda h:P**2/(h**2+P**2),\n 'P/(h2+P2)':lambda h:P/(h**2+P**2),\n 'exp(-P/h)':lambda h:np.exp(-P/h),\n 'P exp(-P/h)':lambda h:P*np.exp(-P/h),\n 'P2 exp(-P/h)':lambda h:P**2*np.exp(-P/h),\n 'log(1+P/h)':lambda h:np.log(1+P/h),\n 'Plog(1+P/h)':lambda h:P*np.log(1+P/h),\n 'tanh':lambda h:np.tanh(P/h),\n 'Ptanh':lambda h:P*np.tanh(P/h),\n 'atan':lambda h:np.arctan(P/h),\n 'P^h':lambda h:P**h,\n 'sin':lambda h:np.sin(P/h),\n 'Psin':lambda h:P*np.sin(P/h),\n 'gauss':lambda h:np.exp(-(P/h)**2),\n 'Pgauss':lambda h:P*np.exp(-(P/h)**2),\n 'PlogP':lambda h:P*np.log(P)+0*h,\n 'P2/(h+P)':lambda h:P**2/(h+P),\n 'P3/(h+P)':lambda h:P**3/(h+P),\n 'P3/(h2+P2)':lambda h:P**3/(h**2+P**2),\n}\nfor base_name,base in [('P,P2',[P,P**2]),('P',[P]),('1,P,P2',[np.ones_like(P),P,P**2]),('none',[])]:\n  print(base_name)\n  for k,fn in shapes.items():\n    best=(1,0)\n    for h in np.geomspace(0.05,50,400):\n        try:\n            v,c=nm(base+[fn(h)])\n            if v<best[0]:best=(v,h,c)\n        except Exception as e: pass\n    if best[0]<1e-6: print(' ',k,best)", "out": "P,P2\n  P/(h+P) (np.float64(9.122696092391544e-07), np.float64(0.6262018772675365), array([ 0.16601992,  0.01569917,  1.78021405, -0.05842229, -1.2499328 ]))\n  atan (np.float64(2.779132213158361e-07), np.float64(0.4429333952050412), array([ 0.1659963 ,  0.01570097,  1.71149897, -0.05263332, -0.61659748]))\n  P2/(h+P) (np.float64(9.122696092391107e-07), np.float64(0.6262018772675365), array([ 0.16601992,  0.01569917, -0.21584001, -0.05842229,  1.99605406]))\n  P3/(h+P) (np.float64(9.12269609239143e-07), np.float64(0.6262018772675365), array([ 0.16601992,  0.01569917, -0.21584001,  3.1291345