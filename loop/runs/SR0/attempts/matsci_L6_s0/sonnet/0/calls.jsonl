{"t": 1795074638.576333, "tool": "analyze", "code": "from numpy.linalg import lstsq\ndef tryf(basis_e,deg=3):\n    cols=[]\n    for be in basis_e:\n        for k in range(deg+1): cols.append(be*T**k)\n    X=np.array(cols).T\n    c,*_=lstsq(X,sigma,rcond=None);r=sigma-X@c\n    return np.mean(r**2)/np.var(sigma)\nfor n in [0.3,0.4,0.5,0.6,0.7,0.8,1]:\n    print(n,tryf([np.ones_like(eps),eps**n]),tryf([np.ones_like(eps),eps**n,eps],3))\nprint(tryf([np.ones_like(eps),eps,np.log(eps)]),tryf([np.ones_like(eps),eps,eps**2]),tryf([np.ones_like(eps),1-np.exp(-eps)]),tryf([np.ones_like(eps),np.tanh(eps)]))", "out": "0.3 0.0020688344458556 3.8815664975508455e-05\n0.4 0.0011041834376765375 2.4735240805070043e-05\n0.5 0.0005100069786208077 1.3906848782879914e-05\n0.6 0.00025238802947263964 6.261006922414278e-06\n0.7 0.0002954703109937851 1.6815449429445325e-06\n0.8 0.0006033235874266055 1.3574873399375193e-08\n1 0.001877009076129078 0.001877009076129077\n0.0001004347475604584 0.00013141868393694008 0.017388812183981067 0.035671180910339884\n"}
