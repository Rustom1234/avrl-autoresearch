{"t": 1795076079.047907, "tool": "analyze", "code": "from scipy.optimize import least_squares\ndef run(f,n,name):\n    best=None\n    for s in range(30):\n        p0=np.random.RandomState(s).randn(n)\n        try:\n            r=least_squares(lambda p:f(p)-dA_dt,p0)\n        except Exception: continue\n        if best is None or r.cost<best.cost:best=r\n    print(name,best.cost,np.round(best.x,4))\nrun(lambda p:p[0]*A**2*np.exp(-p[1]*t)+p[2]*np.abs(A)**p[3]*t**p[4]+p[5]*A**2*t,6,'a')\nrun(lambda p:p[0]*A**2*np.exp(-p[1]*t)+p[2]*A+p[3]*t**p[4]*(1+p[5]*A),6,'b')\nrun(lambda p:p[0]*A**2*np.exp(-p[1]*t)+p[2]*A+p[3]*t+p[4]*t*A+p[5]*A**2,6,'c')\nrun(lambda p:p[0]*A**2*(p[1]+np.exp(-p[2]*t))+p[3]*A*t+p[4]*t**p[5],6,'d')\nrun(lambda p:p[0]*A**2+p[1]*A+p[2]+(p[3]*A**2+p[4])*np.exp(-p[5]*t)+p[6]*t,7,'e')", "out": "a 24.417632873072737 [1.5535 0.3629 0.2526 0.0254 1.4216 0.045 ]\nb 24.55197222235829 [ 1.9091  0.2764 -1.4468  0.4415  1.0767  0.5965]\nc 14.817682042087199 [ 1.6433  0.6128 -1.0416  0.6182  0.1026  0.5198]\nd 11.104072900192683 [ 1.6428  0.3304  0.9336 -0.0375  0.2562  1.4329]\ne 7.097110939742678 [ 0.4738 -0.0222 -1.3292  1.6864  0.3657  0.7856  0.7768]\n"}
