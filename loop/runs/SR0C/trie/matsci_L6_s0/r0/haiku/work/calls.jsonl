{"t": 1795077654.6538117, "tool": "analyze", "code": "import itertools\nTf={'1':np.ones(300),'T':T,'T2':T**2,'T3':T**3}\nEf={'1':np.ones(300),'e':eps,'e2':eps**2,'sqrt':np.sqrt(eps),'loge':np.log(eps),'e_loge':eps*np.log(eps),'e3':eps**3,'1/e':1/eps,'expe':np.exp(-eps)}\nnames=[];cols=[]\nfor a in Ef:\n    for b in Tf:\n        names.append(a+'*'+b); cols.append(Ef[a]*Tf[b])\nA=np.array(cols).T\n# greedy forward selection\nsel=[]\nfor step in range(8):\n    best=None\n    for k in range(A.shape[1]):\n        if k in sel: continue\n        B=A[:,sel+[k]]\n        c=np.linalg.lstsq(B,sigma,rcond=None)[0]\n        r=np.sqrt(np.mean((sigma-B@c)**2))\n        if best is None or r<best[0]: best=(r,k)\n    sel.append(best[1]); print(step,[names[s] for s in sel],best[0])", "out": "0 ['1*T3'] 2.0801341079676643\n1 ['1*T3', 'sqrt*1'] 0.39518797332148015\n2 ['1*T3', 'sqrt*1', 'sqrt*T'] 0.23291536235905835\n3 ['1*T3', 'sqrt*1', 'sqrt*T', '1*1'] 0.10092819280450321\n4 ['1*T3', 'sqrt*1', 'sqrt*T', '1*1', '1*T'] 0.06741273736646489\n5 ['1*T3', 'sqrt*1', 'sqrt*T', '1*1', '1*T', '1/e*1'] 0.05724140882970932\n6 ['1*T3', 'sqrt*1', 'sqrt*T', '1*1', '1*T', '1/e*1', '1/e*T2'] 0.029267475036255798\n7 ['1*T3', 'sqrt*1', 'sqrt*T', '1*1', '1*T', '1/e*1', '1/e*T2', 'e2*T3'] 0.026195494791561014\n"}
