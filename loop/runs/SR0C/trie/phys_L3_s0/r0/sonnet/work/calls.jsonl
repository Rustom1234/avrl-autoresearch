{"t": 1795078671.555246, "tool": "analyze", "code": "res=[]\nfor w in np.arange(0.2,6,0.05):\n  for nm,g in (('sin',np.sin),('cos',np.cos)):\n    for nx,hx in (('1',1+0*x),('x',x),('1/x',1/x),('v',v)):\n      A=np.c_[1+0*x,x,x**3,v,v**2,np.sin(x),hx*g(w*t),hx*np.cos(w*t) if nm=='sin' else hx*np.sin(w*t)]\n      c=np.linalg.lstsq(A,dv_dt,rcond=None)[0]\n      res.append((np.mean((A@c-dv_dt)**2)/np.var(dv_dt),w,nm,nx))\nres.sort();print(res[:6])", "out": "[(np.float64(0.01767197487846464), np.float64(0.2), 'sin', 'x'), (np.float64(0.017671974878464645), np.float64(0.2), 'cos', 'x'), (np.float64(0.018266604162463878), np.float64(0.25), 'cos', 'x'), (np.float64(0.018266604162463878), np.float64(0.25), 'sin', 'x'), (np.float64(0.019144562101815414), np.float64(0.3), 'cos', 'x'), (np.float64(0.019144562101815414), np.float64(0.3), 'sin', 'x')]\n"}
{"t": 1795078675.5974803, "tool": "analyze", "code": "def poly(d,vars):\n    cols=[];names=[]\n    for e in itertools.product(range(d+1),repeat=len(vars)):\n        if sum(e)<=d:\n            cols.append(np.prod([a**k for a,k in zip(vars,e)],axis=0));names.append(e)\n    return np.c_[tuple(cols)],names\nfor d in (2,3,4):\n    A,n=poly(d,[t,x,v]);c=np.linalg.lstsq(A,dv_dt,rcond=None)[0]\n    print(d,np.mean((A@c-dv_dt)**2)/np.var(dv_dt))\nA,n=poly(2,[t,x,v]);c=np.linalg.lstsq(A,dv_dt,rcond=None)[0]\nprint([(a,round(b,3)) for a,b in zip(n,c)])", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 11, in <module>\n  File \"<string>\", line 6, in poly\nNameError: name 'itertools' is not defined. Did you forget to import 'itertools'?\n"}
