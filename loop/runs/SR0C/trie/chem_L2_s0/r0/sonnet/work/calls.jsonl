{"t": 1795076440.4100146, "tool": "analyze", "code": "import warnings;warnings.filterwarnings('ignore')\nfrom scipy.optimize import least_squares\nrng=np.random.default_rng(1)\nforms={\n'g1':(lambda p:-p[0]*A**-p[1]*np.exp(-p[2]*t)-p[3]*A**-p[4]+p[5]*A**p[6]*np.exp(-p[7]*t),8),\n'g2':(lambda p:-p[0]*A**-p[1]*np.exp(-p[2]*t)+p[3]*A**p[4]*np.exp(-p[5]*t)+p[6],7),\n'g3':(lambda p:-p[0]*A**-p[1]*t**-p[2]+p[3]*A**p[4]*np.exp(-p[5]*t)+p[6],7),\n'g4':(lambda p:-p[0]*A**-p[1]*np.exp(-p[2]*t)-p[3]+p[4]*np.exp(p[5]*A-p[6]*t),7),\n}\nfor k,(f,n) in forms.items():\n    best=None\n    for i in range(50):\n        p0=rng.uniform(0.1,3,n)\n        try:r=least_squares(lambda p:np.nan_to_num(f(p)-dA_dt,nan=1e3,posinf=1e3,neginf=-1e3),p0,max_nfev=200)\n        except Exception:continue\n        if best is None or r.cost<best.cost:best=r\n    print(k,best.cost*2/np.sum(dA_dt**2),np.round(best.x,3))", "out": "g1 0.0014059270976669246 [10.324  0.156  0.161  4.365  0.644  3.849  1.593  1.086]\ng2 0.0017417904406437838 [15.661  0.328  0.058  2.945  1.985  1.508  2.384]\ng3 0.0033912098398207174 [27.748  0.168  0.165 13.74   0.83   1.307 12.013]\ng4 0.001776631688479018 [15.461  0.343  0.063 -1.924  2.632  0.725  1.447]\n"}
