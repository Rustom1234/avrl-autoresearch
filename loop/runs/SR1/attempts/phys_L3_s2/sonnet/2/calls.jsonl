{"t": 1795077060.6534774, "tool": "analyze", "code": "from numpy.linalg import lstsq\nL={}\nfs={'1':lambda a:a,'sq':np.sqrt,'sq2':lambda a:a**2,'sq3':lambda a:a**3,'log':np.log,'inv':lambda a:1/a,'exp':np.exp,'exp-':lambda a:np.exp(-a),'sin':np.sin,'cos':np.cos,'sin2':lambda a:np.sin(a/2),'cos2':lambda a:np.cos(a/2),'p15':lambda a:a**1.5}\nfor nm,a in [('t',t),('x',x),('v',v)]:\n    for k,g in fs.items(): L[k+'('+nm+')']=g(a)\nnames=list(L);base=list(names)\nfor a in ['t','x','v']:\n  for b in ['t','x','v']:\n    if a<b:\n      for k1 in fs:\n        for k2 in fs: L[k1+'('+a+')*'+k2+'('+b+')']=fs[k1](eval(a))*fs[k2](eval(b))\nnames=list(L);sel=[]\ndef sc(s):\n    A=np.c_[tuple(L[n] for n in s)+(np.ones_like(t),)];c,*_=lstsq(A,dv_dt,rcond=None);return np.mean((A@c-dv_dt)**2)/np.var(dv_dt)\nfor _ in range(4):\n    best=min((n for n in names if n not in sel),key=lambda n:sc(sel+[n]));sel.append(best);print(sel,sc(sel))", "out": "['sq(t)*cos2(v)'] 0.14926491964163643\n['sq(t)*cos2(v)', '1(t)*exp-(x)'] 0.08112679676211484\n['sq(t)*cos2(v)', '1(t)*exp-(x)', 'sin2(t)*log(v)'] 0.04366026355473353\n['sq(t)*cos2(v)', '1(t)*exp-(x)', 'sin2(t)*log(v)', 'exp-(t)*cos(v)'] 0.027372753670056683\n"}
