{"t": 1795077337.9948835, "tool": "analyze", "code": "import numpy as np\nla=np.log(A); lt=np.log(t); y=dA_dt\ndef fit(cols,target):\n    X=np.column_stack(cols); b=np.linalg.lstsq(X,target,rcond=None)[0]; r=target-X@b\n    return b, np.mean(r**2)/np.var(target)\none=np.ones(300)\n# target: rate directly, poly in A,t\nfor name,cols in [\n ('lin A,t',[one,A,t]),\n ('A2 t2 At',[one,A,t,A*A,t*t,A*t]),\n ('poly3',[one,A,t,A*A,t*t,A*t,A**3,t**3,A*A*t,A*t*t]),\n]:\n    print(name, fit(cols,y)[1])\nprint('logs', fit([one,la,lt,la*la,lt*lt,la*lt],np.log(-y))[1])\nprint('logs cubic', fit([one,la,lt,la*la,lt*lt,la*lt,la**3,lt**3,la*la*lt,la*lt*lt],np.log(-y))[1])\n", "out": "lin A,t 0.12707207007429858\nA2 t2 At 0.04094165418708601\npoly3 0.01873412625964992\nlogs 0.027859005619216396\nlogs cubic 0.0009675995490226277\n"}
{"t": 1795077340.128208, "tool": "analyze", "code": "import numpy as np\nla=np.log(A); lt=np.log(t); y=dA_dt\none=np.ones(300)\nX=np.column_stack([one,la,lt,la*la,lt*lt,la*lt,la**3,lt**3,la*la*lt,la*lt*lt])\nb=np.linalg.lstsq(X,np.log(-y),rcond=None)[0]\nprint(np.round(b,4))\nX2=np.column_stack([one,la,lt,la*lt])\nb2=np.linalg.lstsq(X2,np.log(-y),rcond=None)[0]; print(np.round(b2,4), np.mean((np.log(-y)-X2@b2)**2)/np.var(np.log(-y)))\n", "out": "[ 1.68    0.0248 -0.3502  0.0925  0.3646  0.0997  0.0767 -0.0685  0.0425\n -0.0196]\n[1.6117 0.2724 0.1693 0.0104] 0.283028896519984\n"}
{"t": 1795077344.2936234, "tool": "analyze", "code": "import numpy as np\ny=dA_dt\nbest=[]\nfor p in np.linspace(0,1.5,31):\n  for name,B in [('poly2',[np.ones(300),t,t*t]),('poly2inv',[np.ones(300),t,t*t,1/t]),('poly3',[np.ones(300),t,t*t,t**3]),('exp',[np.ones(300),np.exp(-t),np.exp(t/5)]),('inv',[np.ones(300),1/t,t])]:\n    X=np.column_stack([b*A**p for b in B])\n    c=np.linalg.lstsq(X,-y,rcond=None)[0]; r=-y-X@c\n    best.append((np.mean(r**2)/np.var(y),round(p,2),name,np.round(c,4)))\nbest.sort(key=lambda z:z[0])\nfor z in best[:6]: print(z)\n", "out": "(np.float64(0.13582525209117), np.float64(0.4), 'poly2inv', array([ 2.115 ,  0.8545, -0.0328,  1.7539]))\n(np.float64(0.1384117088528944), np.float64(0.35), 'poly2inv', array([ 2.2218,  0.8876, -0.0342,  1.8291]))\n(np.float64(0.14446449649427684), np.float64(0.4), 'inv', array([3.3241, 1.025 , 0.4495]))\n(np.float64(0.1469766163601806), np.float64(0.45), 'poly2inv', array([ 2.0081,  0.8222, -0.0315,  1.6814]))\n(np.float64(0.14704502158943858), np.float64(0.35), 'inv', array([3.4844, 1.0676, 0.4649]))\n(np.float64(0.1510414027345588), np.float64(0.4), 'poly3', array([ 5.1866, -0.5395,  0.1892, -0.0113]))\n"}
