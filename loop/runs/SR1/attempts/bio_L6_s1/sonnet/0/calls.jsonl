{"t": 1795074908.6181166, "tool": "analyze", "code": "import itertools\nfs={'1':np.ones(300),'P':P,'P2':P**2,'lnP':np.log(P),'sq':np.sqrt(P),'iP':1/P,'eP':np.exp(-P),'P3':P**3}\nts={'1':1,'t':t,'t2':t**2,'et':np.exp(t/5),'st':np.sin(t),'ct':np.cos(t),'lt':np.log(t)}\nnames=[];cols=[]\nfor a in fs:\n  for b in ts:\n    names.append(a+'*'+b);cols.append(fs[a]*ts[b])\ncols=np.array(cols).T\n# greedy forward selection\nsel=[]\nfor step in range(6):\n  best=None\n  for j in range(len(names)):\n    if j in sel:continue\n    X=cols[:,sel+[j]];c,*_=np.linalg.lstsq(X,dP_dt,rcond=None);e=np.abs(X@c-dP_dt).max()\n    if best is None or e<best[0]:best=(e,j,c)\n  sel.append(best[1]);print([names[s] for s in sel],best[0],best[2])", "out": "['eP*1'] 8.04316774121858 [27.86567198]\n['eP*1', '1*t2'] 4.548233004671962 [20.28623261  0.05102141]\n['eP*1', '1*t2', 'iP*1'] 4.378179821107858 [23.5673522   0.05238037 -1.06586939]\n['eP*1', '1*t2', 'iP*1', 'eP*et'] 4.09329133953687 [33.81738203  0.05955305 -2.91794416 -1.21405603]\n['eP*1', '1*t2', 'iP*1', 'eP*et', 'P3*et'] 3.185819982216377 [ 3.07339603e+01  9.29762107e-02 -1.48285223e+00 -2.62834311e+00\n -4.77481895e-03]\n['eP*1', '1*t2', 'iP*1', 'eP*et', 'P3*et', 'P2*1'] 2.925222275214514 [ 2.47020316e+01  9.16112813e-02  3.07526881e-01 -2.48699424e+00\n -3.81302059e-03 -4.23654570e-02]\n"}
