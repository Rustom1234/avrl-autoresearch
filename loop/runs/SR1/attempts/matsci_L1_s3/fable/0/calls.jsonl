{"t": 1795077225.3546162, "tool": "analyze", "code": "from scipy.optimize import least_squares\ng=sigma+0.66*eps**1.5\no=np.argsort(T); print(np.c_[T[o],g[o]][::15])\nforms={'exp':lambda p:p[0]+p[1]*np.exp(p[2]*T),'pow':lambda p:p[0]+p[1]*T**p[2],'cosh':lambda p:p[0]+p[1]*np.cosh(p[2]*T),'sinh':lambda p:p[0]+p[1]*np.sinh(p[2]*T),\n'expm':lambda p:p[0]*np.exp(-p[1]/T)+p[2],'Texp':lambda p:p[0]*T*np.exp(p[1]*T)+p[2],'powl':lambda p:p[0]*T**p[1]+p[2]*T,'explin':lambda p:p[0]*np.exp(p[1]*T)+p[2]*T, 'tan':lambda p:p[0]*np.tan(p[1]*T)+p[2],'log':lambda p:p[0]*np.log(1-T/p[1])+p[2],'rec':lambda p:p[0]/(1-T/p[1])+p[2]}\nfor k,f in forms.items():\n    best=None\n    for s in [[1,1,1],[-1,.3,.5],[-.1,2,0.1],[1,10,1],[-1,10,0],[-1,0.1,0]]:\n        try:\n            r=least_squares(lambda p:f(p)-g,s)\n            if best is None or r.cost<best.cost: best=r\n        except Exception as e: pass\n    print(k,best.cost/np.sum((g-g.mean())**2),best.x)", "out": "[[ 2.00729591 -0.22241644]\n [ 2.2872236  -0.32904748]\n [ 2.47732317 -0.4181005 ]\n [ 2.74013831 -0.56578333]\n [ 2.91700714 -0.68256682]\n [ 3.13781774 -0.84960261]\n [ 3.29851826 -0.98693687]\n [ 3.3956973  -1.07676171]\n [ 3.57213303 -1.25347468]\n [ 3.77294307 -1.47697604]\n [ 3.93176023 -1.67145146]\n [ 4.21495942 -2.05926807]\n [ 4.43554072 -2.39978539]\n [ 4.64675407 -2.75919096]\n [ 4.79609066 -3.03385518]\n [ 4.98476736 -3.40617829]\n [ 5.16795946 -3.79568346]\n [ 5.3782846  -4.27822906]\n [ 5.53956398 -4.67476131]\n [ 5.77766538 -5.30383311]]\nexp 0.00016539476310222057 [ 0.907007   -0.40322407  0.47395922]\npow 1.822685954446854e-23 [-2.0947562e-12 -2.7500000e-02  3.0000000e+00]\ncosh 0.0001066258694663664 [ 1.24210502 -0.97401056 -0.44923312]\nsinh 0.00021981001171709412 [ 0.69060467  0.70311125 -0.49229244]\nexpm 0.0005789856052541076 [-83.8495659   16.40663314  -0.34681215]\nTexp 0.00011403098424654125 [-0.14223904  0.33621441  0.40917471]\npowl 1.821444818124628e-23 [-2.7500000e-02  3.0000000e+00 -1.3856971e-