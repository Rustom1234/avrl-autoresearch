{"t": 1795077088.8429775, "tool": "analyze", "code": "from scipy.optimize import least_squares\nforms={\n'A/(1+KA)^p':lambda p:-p[0]*A/(1+np.abs(p[1])*A)**p[2],\n'A^n/(1+KA^m)':lambda p:-p[0]*A**p[2]/(1+np.abs(p[1])*A**p[3]),\n'log(1+KA)':lambda p:-p[0]*np.log(1+np.abs(p[1])*A)+p[2]*A,\n'pow+lin':lambda p:-p[0]*A**p[1]+p[2]*A,\n'pow+pow':lambda p:-p[0]*A**p[1]+p[2]*A**p[3],\n'tanh':lambda p:-p[0]*np.tanh(p[1]*A)+p[2]*A,\n'1-exp':lambda p:-p[0]*(1-np.exp(-np.abs(p[1])*A))+p[2]*A,\n'atan':lambda p:-p[0]*np.arctan(p[1]*A)+p[2]*A,\n'A/sqrt(1+KA^2)':lambda p:-p[0]*A/(1+np.abs(p[1])*A**2)**p[2]+p[3]*A,\n'sqrtform':lambda p:-p[0]*A/(1+np.abs(p[1])*np.sqrt(A))**p[2]+p[3]*A,\n'asinh':lambda p:-p[0]*np.arcsinh(p[1]*A)+p[2]*A,\n}\nrng=np.random.default_rng(0)\nfor n,f in forms.items():\n    best=None\n    for i in range(12):\n        p0=rng.uniform(0.2,2,4)\n        try:\n            r=least_squares(lambda q:f(q[:4])+t**3*(q[4]*A+q[5])-dA_dt,list(p0)+[0.0025,-0.006],x_scale='jac')\n        except Exception as e: continue\n        if best is None or r.cost<best.cost: best=r\n    print(n,2*best.cost/len(t)/np.var(dA_dt),best.x)", "out": "A/(1+KA)^p 1.9017729182798005e-07 [ 2.64318331e+00 -4.27566895e-01  6.59589000e-01 -9.75934353e+01\n  2.52031232e-03 -5.95077192e-03]\nA^n/(1+KA^m) 5.292128561277999e-08 [ 2.88689619e+00  3.81280522e-01  1.02843898e+00  8.23225300e-01\n  2.51995264e-03 -5.94989563e-03]\nlog(1+KA) 1.1117427827983218e-23 [ 4.55000000e+00  5.83000000e-01 -9.51824634e-13  1.00704424e+03\n  2.52000000e-03 -5.95000000e-03]\npow+lin 7.221002329369735e-05 [-1.57245140e+00  1.27199845e+00 -3.65659995e+00 -7.07423799e+02\n  2.51492441e-03 -5.93753747e-03]\npow+pow 6.0878652883731435e-05 [ 2.51976326e+01  1.10054763e+00  2.31135009e+01  1.12802611e+00\n  2.51572170e-03 -5.93964735e-03]\ntanh 0.00040491578997871693 [ 1.92719158e+00  7.16408120e-01 -9.02249184e-01  1.52871668e+03\n  2.53898916e-03 -5.99860232e-03]\n1-exp 1.600778971945146e-05 [ 3.02691109e+00 -6.28982224e-01