{"t": 1795077073.1258276, "tool": "analyze", "code": "from scipy.optimize import least_squares\nK=7\ndef mk(p):\n    return np.c_[[A**k for k in range(K)]+[t**p*A**k for k in range(K)]].T\nfor p in [2,2.5,2.9,3,3.1,3.5,4]:\n    X=mk(p); c=np.linalg.lstsq(X,dA_dt,rcond=None)[0]; r=dA_dt-X@c\n    print(p,np.mean(r**2)/np.var(dA_dt))\nX=mk(3); c=np.linalg.lstsq(X,dA_dt,rcond=None)[0]\na=np.linspace(0.2,4,20)\nf=sum(c[k]*a**k for k in range(K)); h=sum(c[K+k]*a**k for k in range(K))\nfor x in zip(a,f,h): print(np.round(x,5))\n# also general g(t) with h(A): \nX=np.c_[[A**k for k in range(K)]+[t**j*A**k for k in range(3) for j in range(1,6)]].T\nc=np.linalg.lstsq(X,dA_dt,rcond=None)[0]; r=dA_dt-X@c\nprint(np.mean(r**2)/np.var(dA_dt)); print(c[K:].reshape(3,5))", "out": "2 0.014591055929542992\n2.5 0.0031265107544352685\n2.9 0.00011109834649352834\n3 5.317068544123812e-09\n3.1 0.00010520475460353996\n3.5 0.0023567948364629806\n4 0.008295188338233785\n[ 0.2     -0.50211 -0.00545]\n[ 0.4     -0.95355 -0.00494]\n[ 0.6     -1.36473 -0.00444]\n[ 0.8     -1.74185 -0.00393]\n[ 1.      -2.09    -0.00343]\n[ 1.2     -2.41331 -0.00293]\n[ 1.40000e+00 -2.71514e+00 -2.42000e-03]\n[ 1.60000e+00 -2.99822e+00 -1.92000e-03]\n[ 1.80000e+00 -3.26477e+00 -1.41000e-03]\n[ 2.0000e+00 -3.5166e+00 -9.1000e-04]\n[ 2.20000e+00 -3.75523e+00 -4.10000e-04]\n[ 2.40000e+00 -3.98194e+00  1.00000e-04]\n[ 2.60000e+00 -4.19785e+00  6.00000e-04]\n[ 2.80000e+00 -4.40393e+00  1.11000e-03]\n[ 3.00000e+00 -4.60106e+00  1.61000e-03]\n[ 3.20000e+00 -4.79005e+00  2.11000e-03]\n[ 3.40000e+00 -4.97157e+00  2.62000e-03]\n[ 3.60000e+00 -5.14618e+00  3.12000e-03]\n[ 3.80000e+00 -5.31426e+00  3.63000e-03]\n[ 4.00000e+00 -5.47598e+00  4.13000e-03]\n4.955784413237387e-09\n[[-4.71784646e-04  3.14100481e-04 -6.02709040e-03  7.80110307e-06\n  -2.77913385e-07]\n [ 4.22657510e-04 -3.19705835e-04  2.60432878e-03 -9.06484315e-06\n   3.42470442e-07]\n [-7.76816540e-05  6.55206475e-05 -1.82628074e-05  2.04377529e-06\n  -7.99166644e