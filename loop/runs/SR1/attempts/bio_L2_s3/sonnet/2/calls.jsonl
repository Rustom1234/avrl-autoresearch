{"t": 1795075637.5820463, "tool": "analyze", "code": "y=dP_dt\ndef fit(F):\n    ks=list(F);A=np.array([F[k] for k in ks]).T\n    c=np.linalg.lstsq(A,y,rcond=None)[0];return np.std(y-A@c)/np.std(y)\nfor nm,g in {'P':P,'lnP':np.log(P),'1/P':1/P,'sqrtP':np.sqrt(P),'exp-P':np.exp(-P)}.items():\n  for nt,h in {'t':t,'lnt':np.log(t),'sqrtt':np.sqrt(t),'1/t':1/t}.items():\n    F={f'{i}{j}':g**i*h**j for i in range(4) for j in range(4) if i+j<=4}\n    print(nm,nt,round(fit(F),5))", "out": "P t 0.00645\nP lnt 0.03052\nP sqrtt 0.00722\nP 1/t 0.26496\nlnP t 0.02428\nlnP lnt 0.04223\nlnP sqrtt 0.026\nlnP 1/t 0.2673\n1/P t 0.07672\n1/P lnt 0.0838\n1/P sqrtt 0.07806\n1/P 1/t 0.2759\nsqrtP t 0.0087\nsqrtP lnt 0.0322\nsqrtP sqrtt 0.0093\nsqrtP 1/t 0.26677\nexp-P t 0.06846\nexp-P lnt 0.07543\nexp-P sqrtt 0.06898\nexp-P 1/t 0.2729\n"}
{"t": 1795075643.9797316, "tool": "analyze", "code": "y=dP_dt\nPb=np.array([P**i for i in range(5)]).T\ntb=np.array([t**i for i in range(5)]).T\n# y = f(P) + g(t) + g(t)*h(P)?  try y=f(P)+g(t)*h(P)\nrng=np.random.default_rng(0)\nh=Pb@np.array([1,.1,0,0,0.])\nfor it in range(200):\n    A=np.hstack([Pb,tb*h[:,None]]);c=np.linalg.lstsq(A,y,rcond=None)[0]\n    f=Pb@c[:5];g=tb@c[5:]\n    A2=np.hstack([tb*0+g[:,None]*Pb]);c2=np.linalg.lstsq(np.hstack([Pb,g[:,None]*Pb]),y,rcond=None)[0]\n    h=Pb@c2[5:]\n    # fixed f from c2\nprint(np.std(y-np.hstack([Pb,g[:,None]*Pb])@c2)/np.std(y))\n# additive+mult: print shapes\nts=np.linspace(0.5,12,8);Ps=np.linspace(0.3,6,8)\nprint(np.polyval(c[5:][::-1],ts).round(2));print(np.polyval(c2[:5][::-1],Ps).round(2),np.polyval(c2[5:][::-1],Ps).round(2))", "out": "0.026676684593484917\n[ 5.54  6.2   6.92  7.73  8.63  9.63 10.72 11.9 ]\n[ 5.37  2.26 -0.38 -2.6  -4.5  -6.2  -7.84 -9.61] [0.85 0.93 1.04 1.17 1.32 1.48 1.67 1.88]\n"}
