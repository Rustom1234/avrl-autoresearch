{"t": 1795075980.9775417, "tool": "analyze", "code": "def B(x,n,lo,hi):\n    z=(x-lo)/(hi-lo);return np.array([np.cos(k*np.arccos(2*z-1)) for k in range(n)]).T\nBA=B(np.log(A),8,np.log(.2),np.log(4));Bt=B(t,8,.5,10)\nfor name,u in [('1/A',1/A),('A^-.5',A**-.5),('1',A*0+1),('A^-1.5',A**-1.5)]:\n    X=np.hstack([BA,Bt*u[:,None]]);c=np.linalg.lstsq(X,dA_dt,rcond=None)[0]\n    print(name,np.mean((X@c-dA_dt)**2))\n# fully additive f(A)+h(t)\nX=np.hstack([BA,Bt]);c=np.linalg.lstsq(X,dA_dt,rcond=None)[0];print('add',np.mean((X@c-dA_dt)**2))\n# multiplicative-ish: log t basis too\nX=np.hstack([BA,(BA[:,1:,None]*Bt[:,None,1:4]).reshape(300,-1),Bt]);c=np.linalg.lstsq(X,dA_dt,rcond=None)[0];print('inter',np.mean((X@c-dA_dt)**2))", "out": "1/A 6.105637944818e-07\nA^-.5 0.4835637429192829\n1 1.7303531098863216\nA^-1.5 0.24676547909019958\nadd 1.7303531098863216\ninter 1.323443213353555e-06\n"}
