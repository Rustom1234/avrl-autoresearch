{"t": 1795074831.4529033, "tool": "analyze", "code": "import numpy as np\ndef fit(cols,names):\n    A=np.column_stack(cols)\n    c,res,_,_=np.linalg.lstsq(A,sigma,rcond=None)\n    r=sigma-A@c\n    print(names, 'NMSE', np.mean(r**2)/np.var(sigma))\n    return c\nfit([np.ones_like(eps),T,eps,eps**2,eps*T],'1,T,e,e2,eT')\nfit([np.ones_like(eps),T,T**2,eps,eps**2,eps*T,eps**2*T,eps**3],'poly')\nfit([np.ones_like(eps),T,T**2,np.log(eps),eps,eps*T,eps*np.log(eps)],'log')\nfit([np.ones_like(eps),T,T**2,eps,eps**2,eps**3,eps**4,eps*T,eps**2*T,eps**3*T,eps**4*T],'poly4')", "out": "1,T,e,e2,eT NMSE 0.011514344371425624\npoly NMSE 8.722856112654675e-24\nlog NMSE 0.0015812474036798506\npoly4 NMSE 8.653969519933597e-24\n"}
