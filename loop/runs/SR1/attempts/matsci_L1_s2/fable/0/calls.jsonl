{"t": 1795077209.2546654, "tool": "analyze", "code": "from scipy.optimize import least_squares\n# additive test: polynomial in eps + poly in T vs with interactions\ndef fit(A):\n    c,_,_,_=np.linalg.lstsq(A,sigma,rcond=None);r=sigma-A@c;return c,np.var(r)/np.var(sigma)\nAe=np.c_[[eps**k for k in range(1,6)]].T;At=np.c_[[T**k for k in range(0,6)]].T\nprint(fit(np.c_[Ae,At]))\nX=np.c_[Ae,At,np.c_[[eps**i*T**j for i in range(1,4) for j in range(1,4)]].T]\nprint(fit(X)[1])\n# small eps behavior: sigma vs T\nfor f,name in [(T**2,'T2'),(T*np.log(T),'TlogT'),(np.exp(T/3),'exp'),(T**1.5,'T1.5')]:\n    print(name,fit(np.c_[Ae,np.ones(300),T,f])[1])\nfor f,name in [(eps**0.5,'sqrt'),(np.log(eps),'log'),(np.log1p(eps),'log1p'),(np.exp(eps/2),'exp'),(np.sinh(eps),'sinh'),(np.exp(eps),'expe')]:\n    print(name,fit(np.c_[At,eps,eps**2,eps**3,f])[1])", "out": "(array([-3.42253309e-12,  4.46641433e-12,  3.43000000e-02,  3.18999581e-13,\n       -1.80564656e-14, -1.47478654e-10,  1.81519307e-10, -1.63000000e-01,\n        1.80507221e-11, -1.78625391e-12,  6.33857116e-14]), np.float64(8.59983849720351e-24))\n8.48738805771533e-24\nT2 8.728446336160996e-24\nTlogT 7.749648389824368e-05\nexp 0.0001220808903590885\nT1.5 1.893365643662001e-05\nsqrt 8.594297477978087e-24\nlog 8.592441897863652e-24\nlog1p 8.59781027495277e-24\nexp 8.601300616133294e-24\nsinh 8.602420662109293e-24\nexpe 8.602549464531372e-24\n"}
