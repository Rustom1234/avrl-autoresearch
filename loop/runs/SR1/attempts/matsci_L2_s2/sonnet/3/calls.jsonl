{"t": 1795076601.6036985, "tool": "analyze", "code": "E=[eps**0,eps,eps**2,eps**3,np.log(eps),1/eps,np.sqrt(eps)]\nTb=[T**0,T,T**2,T**3]\nnames=[];cols=[]\nfor i,e in enumerate(E):\n    for j,t in enumerate(Tb):\n        cols.append(e*t);names.append((i,j))\nA=np.array(cols).T\nc,res,rk,s=np.linalg.lstsq(A,sigma,rcond=None)\nprint(np.mean((A@c-sigma)**2)/sigma.var())\n# greedy forward selection\nsel=[];r=sigma.copy()\nfor k in range(7):\n    best=None\n    for n in range(A.shape[1]):\n        if n in sel: continue\n        B=A[:,sel+[n]];cc=np.linalg.lstsq(B,sigma,rcond=None)[0]\n        err=np.mean((B@cc-sigma)**2)/sigma.var()\n        if best is None or err<best[0]: best=(err,n,cc)\n    sel.append(best[1]);print(best[0],[names[s] for s in sel],best[2].round(3))", "out": "5.282421911831766e-09\n0.49458529955693203 [(4, 0)] [-4.039]\n0.16339940795996766 [(4, 0), (3, 2)] [-5.976e+00  3.000e-03]\n0.017851764642906442 [(4, 0), (3, 2), (0, 0)] [-5.019e+00  3.000e-03 -1.614e+00]\n0.000161147434203824 [(4, 0), (3, 2), (0, 0), (5, 0)] [-3.537e+00  3.000e-03 -3.460e+00  1.392e+00]\n8.180611222005273e-05 [(4, 0), (3, 2), (0, 0), (5, 0), (3, 0)] [-3.648e+00  3.000e-03 -3.376e+00  1.325e+00  2.000e-03]\n2.9468750153672225e-05 [(4, 0), (3, 2), (0, 0), (5, 0), (3, 0), (6, 0)] [-2.544  0.003 -2.089  1.589  0.005 -1.549]\n2.459927566989147e-07 [(4, 0), (3, 2), (0, 0), (5, 0), (3, 0), (6, 0), (1, 0)] [ 2.1180e+00  3.0000e-03  8.3840e+00  2.1330e+00 -5.0000e-03 -1.5302e+01\n  2.7660e+00]\n"}
