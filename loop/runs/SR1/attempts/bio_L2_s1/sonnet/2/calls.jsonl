{"t": 1795075623.902575, "tool": "analyze", "code": "from scipy.optimize import least_squares\ndef run(fn,n,tries=30):\n    best=None\n    rng=np.random.default_rng(0)\n    for _ in range(tries):\n        try:\n            r=least_squares(lambda p:fn(p)-dP_dt,rng.normal(0,2,n))\n        except Exception: continue\n        if best is None or r.cost<best.cost: best=r\n    return best.cost/len(t)/dP_dt.var()*2,np.round(best.x,3)\nfs={\n'A':(lambda p:p[0]+p[1]*t+p[2]*P**2+p[3]*np.log(P)+p[4]*P+p[5]*P*t+p[6]*np.exp(-p[7]*P),8),\n'B':(lambda p:(p[0]+p[1]*t)*(1+p[2]*np.log(P))+p[3]*P**p[4]+p[5],6),\n'C':(lambda p:p[0]+p[1]*t+p[2]*P**p[3]+p[4]*np.log(P)+p[5]*t*P**p[3],6),\n'D':(lambda p:p[0]+p[1]*np.log(t)+p[2]*P**2+p[3]*np.log(P)+p[4]*P+p[5]*P*np.log(t),6)}\nfor k,(f,n) in fs.items(): print(k,run(f,n))", "out": "A (np.float64(0.0008266186948327936), array([ 29.172,   0.253,  -0.066, -21.458,   2.534,   0.105, -52.576,\n         1.095]))\nB (np.float64(0.01868600086429197), array([-1.615,  0.378,  0.612, -1.088,  1.247, 17.116]))\nC (np.float64(0.016595264004060785), array([16.373,  0.302, -1.96 ,  1.137,  0.882,  0.077]))\nD (np.float64(0.06263683769348286), array([16.918,  1.347,  0.021,  1.452, -2.922,  0.387]))\n"}
{"t": 1795075630.860999, "tool": "analyze", "code": "def fit(cols):\n    X=np.c_[tuple(cols)];c,*_=np.linalg.lstsq(X,dP_dt,rcond=None);r=dP_dt-X@c;return (r**2).mean()/dP_dt.var(),r,c\no=np.ones_like(t)\nT=[o,t,t**2,t**3,np.sqrt(t),np.log(t)]\nH=[P,P**2,P**3,np.log(P),1/P,np.sqrt(P)]\nprint(fit(T+H)[0])\nprint(fit(T+H+[t*P,t*P**2,t*np.log(P)])[0])\nprint(fit(T+H+[t*P,t*P**2,t*np.log(P),P*np.log(P),P**2*np.log(P)])[0])\nfor i,h in enumerate(H): print(i,fit(T+[x for j,x in enumerate(H) if j!=i]+[t*P])[0])", "out": "0.028833278222789714\n1.161770509661562e-06\n7.638665116864817e-07\n0 0.0008206623098218283\n1 0.000810102966775411\n2 0.0007698501421816942\n3 0.0007413322121286527\n4 0.0007505555059056305\n5 0.0007822819930982872\n"}
