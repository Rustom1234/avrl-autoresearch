{"t": 1795075503.5921721, "tool": "analyze", "code": "cands={'1':np.ones(300),'x':x,'x2':x**2,'1/x':1/x,'1/x2':1/x**2,'1/x3':1/x**3,'logx':np.log(x),'v':v,'1/v':1/v,'v2':v**2,'logv':np.log(v),'sqrtv':np.sqrt(v),'sint':np.sin(t),'cost':np.cos(t),'sinx':np.sin(x),'cosx':np.cos(x),'xv':x*v,'v/x':v/x,'x3':x**3}\nimport itertools\nnames=list(cands);best=[]\nfor k in (4,5):\n  for s in itertools.combinations(names[1:],k-1):\n    A=np.c_[tuple(cands[n] for n in ('1',)+s)]\n    c=np.linalg.lstsq(A,dv_dt,rcond=None)[0]\n    best.append((np.mean((A@c-dv_dt)**2)/np.var(dv_dt),s))\nbest.sort();print(best[:8])", "out": "[(np.float64(0.06511103766339253), ('1/v', 'v2', 'cosx', 'v/x')), (np.float64(0.06562670594193107), ('1/v', 'cosx', 'xv', 'v/x')), (np.float64(0.06587348028860911), ('v', '1/v', 'cosx', 'v/x')), (np.float64(0.06773203474433194), ('1/v', 'sqrtv', 'cosx', 'v/x')), (np.float64(0.06814445164921691), ('x', '1/v', 'v2', 'v/x')), (np.float64(0.0691968615610879), ('x', 'v', '1/v', 'v/x')), (np.float64(0.07073785734502402), ('1/v', 'logv', 'cosx', 'v/x')), (np.float64(0.07103291271229309), ('x', '1/v', 'xv', 'v/x'))]\n"}
{"t": 1795075509.152894, "tool": "analyze", "code": "base=[np.ones(300),x,x**2,x**3,v,v**2,1/v]\nres=[]\nfor w in np.arange(0.1,15,0.05):\n  A=np.c_[tuple(base+[np.sin(w*t),np.cos(w*t)])]\n  c=np.linalg.lstsq(A,dv_dt,rcond=None)[0]\n  res.append((np.mean((A@c-dv_dt)**2)/np.var(dv_dt),w))\nres.sort();print(res[:6])", "out": "[(np.float64(0.14392530041178925), np.float64(9.000000000000002)), (np.float64(0.14393822087148017), np.float64(8.950000000000003)), (np.float64(0.14398822737762865), np.float64(9.050000000000002)), (np.float64(0.14402163806228882), np.float64(8.900000000000002)), (np.float64(0.14412572463508122), np.float64(9.100000000000003)), (np.float64(0.1441655940777352), np.float64(8.850000000000003))]\n"}
{"t": 1795075513.4924936, "tool": "analyze", "code": "def poly(vars,d):\n    cols=[]\n    for i in range(d+1):\n        for j in range(d+1-i):\n            cols.append(vars[0]**i*vars[1]**j)\n    return np.c_[tuple(cols)]\nfor d in (3,5,7):\n    A=poly([x,v],d);c=np.linalg.lstsq(A,dv_dt,rcond=None)[0]\n    print(d,np.mean((A@c-dv_dt)**2)/np.var(dv_dt))\nA=np.c_[poly([x,v],5),np.sin(t),np.cos(t)];c=np.linalg.lstsq(A,dv_dt,rcond=None)[0]\nprint(np.mean((A@c-dv_dt)**2)/np.var(dv_dt))", "out": "3 0.08722103437185848\n5 0.010103992690429801\n7 0.0010124336375084842\n0.010050164339490677\n"}
