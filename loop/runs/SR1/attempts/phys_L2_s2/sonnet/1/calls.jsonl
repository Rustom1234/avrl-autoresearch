{"t": 1795075494.9846392, "tool": "analyze", "code": "def B(z,k=6):\n    q=np.quantile(z,np.linspace(0,1,k+1)[1:-1]);b=np.digitize(z,q)\n    return np.eye(k)[b]\nA=np.c_[B(x,8),B(v,8)[:,1:],B(t,8)[:,1:]]\nc=np.linalg.lstsq(A,dv_dt,rcond=None)[0]\nprint(np.mean((A@c-dv_dt)**2)/np.var(dv_dt))\nprint(c[:8].round(2),c[8:15].round(2),c[15:].round(2))\nprint(np.quantile(x,np.linspace(0,1,9)).round(2),np.quantile(v,np.linspace(0,1,9)).round(2))", "out": "0.2835242373034257\n[-15.65 -13.44 -13.27 -14.06 -14.78 -15.53 -16.73 -17.05] [3.38 4.11 4.44 4.57 4.9  4.77 5.06] [ 0.09  0.25  0.05 -0.19 -0.26  0.21 -0.13]\n[0.2  0.55 0.88 1.17 1.56 1.88 2.29 2.57 2.99] [0.21 0.6  0.98 1.28 1.59 1.94 2.27 2.56 2.99]\n"}
