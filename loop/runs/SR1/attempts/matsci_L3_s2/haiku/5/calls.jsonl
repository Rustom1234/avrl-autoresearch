{"t": 1795078269.4942307, "tool": "analyze", "code": "from numpy.polynomial import polynomial as P\ndef tens(deg_e,deg_t):\n    cols=[]\n    for i in range(deg_e+1):\n        for j in range(deg_t+1):\n            cols.append(eps**i*T**j)\n    return np.column_stack(cols)\nfor de,dt in [(3,3),(5,3),(6,4),(8,4)]:\n    X=tens(de,dt)\n    c,res,_,_=np.linalg.lstsq(X,sigma,rcond=None)\n    r=sigma-X@c\n    print(de,dt, np.mean(r**2)/np.var(sigma))\n# eps-shape at T=3.5 via separable: fit with deg 6 eps, deg 3 T\nX=tens(8,3); c=np.linalg.lstsq(X,sigma,rcond=None)[0]\nge=np.linspace(0.2,5,10)\nprint(np.column_stack([ge, np.array([sum(c[i*4+j]*x**i*3.5**j for i in range(9) for j in range(4)) for x in ge])]).round(3).tolist())", "out": "3 3 0.0007698735851171508\n5 3 0.0005099884981505802\n6 4 6.958642046451797e-06\n8 4 4.469805167871344e-06\n[[0.2, 34.132], [0.733, 32.558], [1.267, 31.728], [1.8, 31.203], [2.333, 30.946], [2.867, 30.893], [3.4, 30.976], [3.933, 31.202], [4.467, 31.607], [5.0, 32.143]]\n"}
