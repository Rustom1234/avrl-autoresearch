{"t": 1795074536.213738, "tool": "analyze", "code": "import numpy as np\none=np.ones_like(t)\nbest=[]\nfor w in np.linspace(0.05,3.0,600):\n    A=np.column_stack([one,P,P**2,np.sin(w*t),np.cos(w*t)])\n    c=np.linalg.lstsq(A,dP_dt,rcond=None)[0]\n    r=dP_dt-A@c\n    best.append((np.var(r)/np.var(dP_dt),w,np.round(c,3)))\nbest.sort(key=lambda x:x[0])\nfor b in best[:5]: print(b)\n# also test P*sin\nbest2=[]\nfor w in np.linspace(0.05,3.0,600):\n    A=np.column_stack([one,P,P**2,np.sin(w*t),np.cos(w*t),P*np.sin(w*t),P*np.cos(w*t)])\n    c=np.linalg.lstsq(A,dP_dt,rcond=None)[0]\n    r=dP_dt-A@c\n    best2.append((np.var(r)/np.var(dP_dt),w,np.round(c,3)))\nbest2.sort(key=lambda x:x[0])\nfor b in best2[:3]: print(b)", "out": "(np.float64(0.02626655227652297), np.float64(0.05), array([-34.614,   2.415,  -0.063,  16.584,  40.378]))\n(np.float64(0.026281091266462414), np.float64(0.05492487479131887), array([-27.208,   2.415,  -0.063,  15.046,  32.975]))\n(np.float64(0.026297063776128247), np.float64(0.05984974958263773), array([-21.554,   2.415,  -0.063,  13.757,  27.325]))\n(np.float64(0.026314488545542927), np.float64(0.06477462437395659), array([-17.14 ,   2.415,  -0.063,  12.66 ,  22.914]))\n(np.float64(0.02633338603734829), np.float64(0.06969949916527546), array([-13.628,   2.415,  -0.063,  11.715,  19.406]))\n(np.float64(0.006372142335642589), np.float64(0.05), array([-5.4424e+01,  8.3190e+00, -8.7000e-02,  1.7125e+01,  6.1005e+01,\n       -4.1000e-02, -6.0870e+00]))\n(np.float64(0.006384147440082552), np.float64(0.05492487479131887), array([-4.3639e+01,  7.3280e+00, -8.7000e-02,  1.5568e+01,  5.0221e+01,\n       -4.7000e-02, -5.0950e+00]))\n(np.float64(0.006397357508690957), np.float64(0.05984974958263773), array([-35.406,   6.572,  -0.087,  14.265,  41.988,  -0.053,  -4.338]))\n"}
