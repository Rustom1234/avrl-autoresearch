{"t": 1795078723.2183347, "tool": "analyze", "code": "from scipy.optimize import least_squares\ny=dA_dt\ndef mk(f):\n    def res(p): \n        r=f(t,A,p); return (r-y)\n    return res\nbest=None\nforms={\n 'a': lambda t,A,p: -(p[0]+p[1]*t)*A**p[2]/(1+p[3]*A)**p[4],\n 'b': lambda t,A,p: -(p[0]+p[1]*t+p[5]*t*t)*A**p[2]*np.exp(-p[3]*A)/(1+p[4]*A),\n 'c': lambda t,A,p: -(p[0]*np.exp(p[1]*t)+p[5])*A**p[2]*np.exp(-p[3]*A**2)+p[4]*t,\n}\nfor name,f in forms.items():\n    bb=None\n    for s in range(30):\n        p0=np.random.rand(6)*2\n        try:\n            r=least_squares(mk(f),p0)\n            if bb is None or r.cost<bb.cost: bb=r\n        except Exception as e: pass\n    print(name, 2*bb.cost/np.sum((y-y.mean())**2), np.round(bb.x,4))\n", "out": "a 0.020560599055743013 [18.0359  1.6619  0.7622  0.1479  5.8319  1.5316]\nb 0.020046673821306128 [ 1.66008e+01  1.44510e+00  7.15700e-01  8.86500e-01 -1.60000e-01\n  7.00000e-03]\nc 0.011665638446199432 [-1.0001  0.0906  0.4628  0.1695 -0.6845 11.2415]\n\n[stderr]\n<string>:12: RuntimeWarning: invalid value encountered in power\n"}
{"t": 1795078726.3842325, "tool": "analyze", "code": "cols=[]\nnames=[]\nfor i in range(0,4):\n  for j in range(0,3):\n    cols.append(A**i * t**j); names.append((i,j))\nX=np.column_stack(cols)\nc,_,_,_=np.linalg.lstsq(X,dA_dt,rcond=None)\nprint(1-np.sum((X@c-dA_dt)**2)/np.sum((dA_dt-dA_dt.mean())**2))\nfor n,v in zip(names,c): print(n,round(v,4))\n# also with 1/A terms\ncols2=cols+[A**-1*t**j for j in range(2)]+[np.sqrt(A)*t**j for j in range(2)]\nX2=np.column_stack(cols2)\nc2,_,_,_=np.linalg.lstsq(X2,dA_dt,rcond=None)\nprint(1-np.sum((X2@c2-dA_dt)**2)/np.sum((dA_dt-dA_dt.mean())**2))\n", "out": "0.9889387536301187\n(0, 0) -2.6926\n(0, 1) -0.9138\n(0, 2) 0.0308\n(1, 0) -10.9116\n(1, 1) 0.4383\n(1, 2) -0.0435\n(2, 0) 5.8958\n(2, 1) -0.1847\n(2, 2) 0.0194\n(3, 0) -0.7942\n(3, 1) 0.0252\n(3, 2) -0.0028\n0.9999667243949008\n"}
{"t": 1795078730.6346915, "tool": "analyze", "code": "forms={\n 'sqrtexp': lambda t,A,p: -(p[0]+p[1]*t)*A**p[2]*np.exp(-p[3]*A)*(1+p[4]*A),\n 'poly_t': lambda t,A,p: -(p[0]+p[1]*t)*A*(1-p[2]*A+p[3]*A**2)/(1+p[4]*t),\n 'expt': lambda t,A,p: -p[0]*A**p[1]*np.exp(p[2]*t-p[3]*A)*(1+p[4]*A),\n 'ratio': lambda t,A,p: -(p[0]+p[1]*t)*A**p[2]/(1+p[3]*A**p[4]),\n}\nfor name,f in forms.items():\n    bb=None\n    for s in range(60):\n        p0=np.random.rand(6)*1.5\n        try:\n            with np.errstate(all='ignore'):\n                r=least_squares(mk(f),p0)\n            if np.isfinite(r.cost) and (bb is None or r.cost<bb.cost): bb=r\n        except Exception as e: pass\n    print(name, 2*bb.cost/np.sum((y-y.mean())**2), np.round(bb.x,4))\n", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 19, in <module>\nAttributeError: 'NoneType' object has no attribute 'cost'\n"}
