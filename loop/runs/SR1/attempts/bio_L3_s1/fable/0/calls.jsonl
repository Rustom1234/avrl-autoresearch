{"t": 1795074797.302634, "tool": "analyze", "code": "from scipy.optimize import least_squares\ndef best(f,n,tries=30):\n    b=None;rng=np.random.default_rng(0)\n    for i in range(tries):\n        try:\n            s=least_squares(lambda p:f(p)-dP_dt,rng.normal(0,1,n)+0.5)\n            if b is None or s.cost<b.cost:b=s\n        except Exception as e: pass\n    return 2*b.cost/len(P)/np.var(dP_dt),b.x.round(5)\nprint(best(lambda p:p[0]/P+p[1]*P+p[2]*P*t+p[3]*P*P*t+p[4]*P*P+(p[5]+p[6]*t)*np.sin(p[7]*P+p[8])+p[9],10))\nprint(best(lambda p:p[0]*P**p[1]+p[2]*P+p[3]*P*t+p[4]*P*P*t+(p[5]+p[6]*t)*np.sin(p[7]*P),8))\nprint(best(lambda p:p[0]/P+p[1]*P+p[2]*P*t*(1-P/p[3])+p[4]*np.sin(p[5]*t+p[6])*np.sin(p[7]*P),8))", "out": "(np.float64(5.3851496609480455e-06), array([-4.25713, -1.76909,  0.06414, -0.01073,  0.06005, -0.10628,\n       -0.27051,  0.62574, -3.16869,  0.77721]))\n(np.float64(7.83663221345683e-05), array([-3.73644e+00, -1.07367e+00, -1.34206e+00,  1.74700e-02,\n       -1.73000e-03,  1.36980e-01, -3.33660e-01, -6.20060e-01]))\n(np.float64(0.00033242766529776165), array([-4.03117, -1.31251,  0.17406,  5.87724,  2.48484, -0.05083,\n       -0.00749, -0.74801]))\n"}
{"t": 1795074809.1930742, "tool": "analyze", "code": "def fit(cols):\n    A=np.c_[cols].T\n    c=np.linalg.lstsq(A,dP_dt,rcond=None)[0]\n    return np.var(dP_dt-A@c)/np.var(dP_dt),c\nL=np.log(P)\npw=[P**k for k in range(-1,7)]\nprint('poly F + t polyG',fit(pw+[t*P**k for k in range(0,7)])[0])\nprint('+t2',fit(pw+[t*P**k for k in range(0,7)]+[t*t*P**k for k in range(0,5)])[0])\nn,c=fit(pw+[t*P**k for k in range(0,7)])\ng=np.linspace(0.3,6,20)\nF=sum(c[i]*g**(i-1) for i in range(8)); G=sum(c[8+k]*g**k for k in range(7))\nfor a,b,d in zip(g,F,G):print(round(a,2),round(b,4),round(d,4), round(b*a,4), round(d/a,4))\nFb={'1/P':1/P,'P':P,'P2':P*P,'PlogP':P*L,'logP':L,'1':1+0*P,'sqrtP':P**.5,'sinP':np.sin(P),'cosP':np.cos(P),'P^1.5':P**1.5,'exp-P':np.exp(-P),'P/(1+P)':P/(1+P),'P2/(1+P2)':P*P/(1+P*P),'1/(1+P)':1/(1+P),'1/(1+P2)':1/(1+P*P)}\nGb={k+'*t':v*t for k,v in Fb.items()}\nimport itertools\nout=[]\nfor f in itertools.combinations(Fb,2):\n  for gg in list(itertools.combinations(Gb,1))+list(itertools.combinations(Gb,2)):\n    out.append((fit([Fb[k] for k in f]+[Gb[k] for k in gg])[0],f,gg))\nout.sort(key=lambda x:x[0])\nfor o in out[:12]:print(o)", "out": "poly F + t polyG 3.847206868817846e-08\n+t2 3.74297422623982e-08\n0.3 -13.9135 0.0649 -4.174 0.2163\n0.6 -7.3362 0.1274 -4.4017 0.2124\n0.9 -5.4347 0.186 -4.8912 0.2067\n1.2 -4.7164 0.2387 -5.6597 0.1989\n1.5 -4.4741 0.2839 -6.7112 0.1893\n1.8 -4.4673 0.3201 -8.0412 0.1778\n2.1 -4.5909 0.3461 -9.6409 0.1648\n2.4 -4.7914 0.3612 -11.4994 0.1505\n2.7 -5.0392 0.3648 -13.6059 0.1351\n3.0 -5.3167 0.3569 -15.95 0.119\n3.3 -5.6129 0.3377 -18.5227 0.1023\n3.6 -5.921 0.3078 -21.3157 0.0855\n3.9 -6.2363 0.2681 -24.3214 0.0687\n4.2 -6.5553 0.22 -27.5323 0.0524\n4.5 -6.8757 0.1648 -30.9406 0.0366\n4.8 -7.1956 0.1045 -34.5387 0.0218\n5.1 -7.5135 0.0409 -38.3189 0.008\n5.4 -7.8287 -0.0241 -42.275 -0.0045\n5.7 -8.1411 -0.0882 -46.404 -0.0155\n6.0 -8.4515 -0.1497 -50.7093 -0.0249\n(np.float64(0.0015014571211556416), ('1/P', 'P'), ('P*t', 'P^1.5*t'))\n(np.float64(0.0032301940936242876), ('1/P', 'P'), ('P*t', 'P2*t'))\n(np.float64(0.003618853634652475), ('1/P', 'P'), ('P2*t', 'P2/(1+P2)*t'))\n(np.float64(0.0051245771220851935), ('1/P', 'P'), ('P2*t', 'sqrtP*t'))\n(np.float64(0.007450215299089016), ('1/P', 'P'), ('P2*t', 'P/(1+P)*t'))\n(np.float64(0.0075129192989328505), ('1/P', 'P'), ('P*t', 'PlogP*t'))\n(np.float64(0.007634093553107761), ('1/P', 'P'), ('P^1.5*t', 'P2/(1+P2)*t'))\n(np.float64(0.009812285137497488), ('1/P', 'P'), ('PlogP*t', 'P2/(1+P2)*t'))\n(np.float64(0.01188290709436973), ('1/P', 'P'), ('sqrtP*t', 'P^1.5*t'))\n(np.float64(0.012332131598778235), ('1/P', 'P'), ('P*t', 'P2/(1+P2)*t'))\n(np.float64(0.012357805788825208), ('1/P', 'P^1.5'), ('P2*t', 'sqrtP*t'))\n(np.float64(0.01271575528938509), ('1/P', 'P^1.5'), ('P*t', 'P^1.5*t'))\n"}
{"t": 1795074831.0470054, "tool": "analyze", "code": "from scipy.optimize import least_squares\nL=np.log(P)\ndef best(f,n,tries=25,seed=0):\n    b=None;rng=np.random.default_rng(seed)\n    for i in range(tries):\n        try:\n            s=least_squares(lambda p:f(p)-dP_dt,rng.normal(0,1,n)+0.5,x_scale='jac',xtol=1e-15,ftol=1e-15,gtol=1e-15)\n            if b is None or s.cost<b.cost:b=s\n        except Exception as e: pass\n    return 2*b.cost/len(P)/np.var(dP_dt),b.x.round(6)\nS=lambda p:p[0]*t*np.sin(p[1]*P)\nap=np.abs\ncands={\n'pow+pow':lambda p:S(p)+p[2]*P**p[3]+p[4]*P**p[5],\n'1/P+P+P2':lambda p:S(p)+p[2]/P+p[3]*P+p[4]*P*P,\n'1/P+P+c':lambda p:S(p)+p[2]/P+p[3]*P+p[4],\n'1/P+P+log':lambda p:S(p)+p[2]/P+p[3]*P+p[4]*L,\n'1/P+P+PlogP':lambda p:S(p)+p[2]/P+p[3]*P+p[4]*P*L,\n'1/(P+a)+P':lambda p:S(p)+p[2]/(P+p[4])+p[3]*P,\n'1/P+P+sat':lambda p:S(p)+p[2]/P+p[3]*P+p[4]*P*P/(p[5]**2+P*P),\n'1/P+P+sat1':lambda p:S(p)+p[2]/P+p[3]*P+p[4]*P/(ap(p[5])+P),\n'1/P+P+exp':lambda p:S(p)+p[2]/P+p[3]*P+p[4]*np.exp(-ap(p[5])*P),\n'1/P+P+sin':lambda p:S(p)+p[2]/P+p[3]*P+p[4]*np.sin(p[5]*P),\n'1/P+P+Pexp':lambda p:S(p)+p[2]/P+p[3]*P+p[4]*P*np.exp(-ap(p[5])*P),\n'pow+P+P2':lambda p:S(p)+p[2]*P**p[5]+p[3]*P+p[4]*P*P,\n'1/P+logistic':lambda p:S(p)+p[2]/P+p[3]*P*(1-ap(P/p[4])**p[5]),\n}\nfor k,f in cands.items():\n    print(k,best(f,6))", "out": "pow+pow (np.float64(0.00022641222067868022), array([-0.364546, -0.596304, -3.571495, -1.109896, -1.54927 ,  0.916575]))\n1/P+P+P2 (np.float64(0.0010628294990323406), array([ 0.369701,  0.601151, -3.942571, -1.348173,  0.008016,  1.580163]))\n1/P+P+c (np.float64(0.0007833409582436733), array([ 0.35167 ,  0.594257, -4.093991, -1.379501,  0.330273, -0.161703]))\n1/P+P+log (np.float64(0.0010386061308218055), array([-0.371025, -0.601638, -4.068221, -1.212774, -0.276225,  0.1837  ]))\n1/P+P+PlogP (np.float64(0.0010793606827541205), array([-0.35995 , -0.598396, -3.961107, -1.270133, -0.025722,  1.121018]))\n1/(P+a)+P (np.float64(0.0004878407008874363