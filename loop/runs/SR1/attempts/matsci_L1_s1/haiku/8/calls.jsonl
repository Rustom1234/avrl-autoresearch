{"t": 1795079008.5770261, "tool": "evaluate", "code": "import numpy as np\ndef equation(eps, T, params):\n    return params[0]*T**params[1]*np.cos(params[2]*eps*T**params[3]) + params[4]*T**params[5]\n", "out": "{\"ok\": true, \"train_nmse\": 0.015343560087946809, \"params\": [0.6721259959384787, 1.4014496940953003, -1.3212646117140665, -0.9472505867048996, -1.6825021314719435, 0.32367929862147826, 0.7519393955576869, -0.6587603195674528, -1.2286749856452768, 0.2575577684128723], \"evals\": {}}"}
{"t": 1795079013.9882815, "tool": "analyze", "code": "from numpy.linalg import lstsq\n# fit sigma = sum_k c_k T^k - b*eps, linear in params, scan b\nfor deg in [2,3,4]:\n    A=np.column_stack([T**k for k in range(deg+1)]+[eps])\n    c,res,_,_=lstsq(A,sigma,rcond=None)\n    r=sigma-A@c\n    print(deg,np.round(c,4),np.sum(r**2)/np.sum((sigma-sigma.mean())**2))\n# try eps*T dependence: sigma = a(T) - b(T)*eps\nfor deg in [2,3]:\n    A=np.column_stack([T**k for k in range(deg+1)]+[eps*T**k for k in range(deg+1)])\n    c,_,_,_=lstsq(A,sigma,rcond=None)\n    r=sigma-A@c\n    print('bT',deg,np.round(c,4),np.sum(r**2)/np.sum((sigma-sigma.mean())**2))", "out": "2 [ 0.    -0.     0.184 -1.21 ] 5.8955166724980804e-24\n3 [-0.     0.     0.184  0.    -1.21 ] 5.872881006047058e-24\n4 [ 0.    -0.     0.184 -0.     0.    -1.21 ] 5.859423017106942e-24\nbT 2 [-0.     0.     0.184 -1.21  -0.     0.   ] 5.8835536030185206e-24\nbT 3 [ 0.    -0.     0.184 -0.    -1.21   0.    -0.     0.   ] 5.713731283346572e-24\n"}
