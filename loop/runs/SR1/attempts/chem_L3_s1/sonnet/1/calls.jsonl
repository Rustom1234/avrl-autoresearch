{"t": 1795075792.5202901, "tool": "analyze", "code": "from scipy.optimize import least_squares\nf=lambda p,t,A:p[0]+p[1]*t-p[2]*A**p[3]\nr=least_squares(lambda p:f(p,t,A)-dA_dt,[10,-.8,.3,2.5]).x;res=dA_dt-f(r,t,A);print(r,np.var(res)/np.var(dA_dt))\nfor nm,x in [('t',t),('A',A)]:\n    best=[]\n    for w in np.arange(0.2,8,0.05):\n        X=np.c_[np.sin(w*x),np.cos(w*x),np.ones_like(x)];c=np.linalg.lstsq(X,res,rcond=None)[0]\n        best.append((np.var(res-X@c),w))\n    print(nm,sorted(best)[:3],np.var(res))", "out": "[10.96412633 -0.85802311  0.31364623  2.59614351] 0.005940257725359417\nt [(np.float64(0.08461404402704814), np.float64(2.05)), (np.float64(0.08464033631680153), np.float64(2.0999999999999996)), (np.float64(0.08471276506351436), np.float64(1.9999999999999996))] 0.08669798351650827\nA [(np.float64(0.08479595078612918), np.float64(2.8)), (np.float64(0.08479765503322122), np.float64(2.8499999999999996)), (np.float64(0.08479795825201523), np.float64(2.7499999999999996))] 0.08669798351650827\n"}
{"t": 1795075798.4224358, "tool": "analyze", "code": "def fit(cols):\n    X=np.c_[tuple(cols)];c=np.linalg.lstsq(X,dA_dt,rcond=None)[0];return np.var(dA_dt-X@c)/np.var(dA_dt),c\none=np.ones_like(t)\nprint('add',fit([one,t,t**2,t**3,A,A**2,A**3,A**4,A**5])[0])\nprint('add+tA',fit([one,t,t**2,t**3,A,A**2,A**3,A**4,A**5,t*A,t*A**2,t*A**3])[0])\nprint('full4',fit([t**i*A**j for i in range(5) for j in range(6)])[0])\nprint('A2,A3 only',fit([one,t,t**2,A**2,A**3])[0])\nprint('exp',fit([one,t,t**2,np.exp(A),np.exp(2*A)])[0], fit([one,t,t**2,np.exp(A)])[0])\nprint('sqrtt',fit([one,np.sqrt(t),t,A**2,A**3])[0])", "out": "add 0.005603910184766746\nadd+tA 0.002886706022539625\nfull4 8.895453372714549e-06\nA2,A3 only 0.005752153487751222\nexp 0.005736675936298299 0.017140846229327017\nsqrtt 0.005768885290552065\n"}
{"t": 1795075806.3760633, "tool": "analyze", "code": "from scipy.optimize import least_squares\nF={\n'a':(lambda p,t,A:p[0]-p[1]*t**p[2]-p[3]*A**p[4]*t**p[5],[11,1.2,.9,.3,2.6,0]),\n'b':(lambda p,t,A:p[0]-p[1]*(t*A**p[2])**p[3]-p[4]*A**p[5],[10,.3,.5,1.5,.3,2.5]),\n'c':(lambda p,t,A:p[0]-p[1]*t**p[2]-p[3]*A**p[4]*np.exp(-p[5]*t)-p[6]*A**p[7],[10,.5,1.2,.3,2.5,.1,.1,2]),\n'd':(lambda p,t,A:p[0]*np.exp(-p[1]*t*A**p[2])-p[3]*A**p[4]+p[5],[10,.1,.5,.3,2.5,0]),\n'e':(lambda p,t,A:p[0]-p[1]*t-p[2]*A**p[3]-p[4]*t*A**p[5],[10,.8,.3,2.5,.0,1]),\n'f':(lambda p,t,A:p[0]-p[1]*np.sqrt(t)*A**p[2]-p[3]*t**p[4]-p[5]*A**p[6],[10,.3,.5,.5,1.5,.3,2.5]),\n}\nfor k,(f,p0) in F.items():\n    for s in range(3):\n        try:\n            r=least_squares(lambda p:f(p,t,A)-dA_dt,np.array(p0)*(1+.2*s*np.random.randn(len(p0))),max_nfev=2000)\n            print(k,np.mean(r.fun**2)/np.var(dA_dt),r.x.round(4))\n        except Exception as e:print(k,e)", "out": "a 0.004922809812951009 [11.6632  1.2422  0.8744  0.3342  2.6101 -0.0559]\na 0.004922809812764592 [11.6632  1.2422  0.8744  0.3342  2.6101 -0.0559]\na 0.004922809812789258 [11.6632  1.2422  0.8744  0.3342  2.6101 -0.0559]\nb 0.005095377471950432 [11.4555  1.0286 -0.0518  0.9385  0.4117  2.4222]\nb 0.005095377472326367 [11.4555  1.0286 -0.0518  0.9385  0.4117  2.4222]\nb 0.043703977068984906 [-7.44792766e+04 -7.44902449e+04  6.35000000e-02 -0.00000000e+00\n  3.21400000e-01  2.53640000e+00]\nc 0.0033901202761926572 [11.7419  1.1523  0.9097  0.214   2.8854  0.0263  0.294   1.1697]\nc 0.00341860683807659 [-7.053320e+02  1.155200e+00  9.100000e-01  2.981000e-01  2.707500e+00\n  2.350000e-02 -7.168707e+02 -2.000000e-04]\nc 0.0033665846035576107 [ 1.16262e+01  1.14910e+00  9.14000e-01  9.20670e+00  2.66060e+00\n  8.00000e-04 -8.86300e+00  2.66220e+00]\nd 0.005117852814555332 [ 7.26673e+01  1.29000e-02 -5.09000e-02  4.08400e-01  2.42770e+00\n -6.13284e+01]\nd 0.005117852814568231 [ 7.26674e+01  1.29000e-02 -5.09000e-02  4.08400e-01  2.42770e+00\n 