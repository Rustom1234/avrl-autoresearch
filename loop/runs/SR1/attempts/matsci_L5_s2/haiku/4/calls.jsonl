{"t": 1795078025.865038, "tool": "analyze", "code": "from numpy.linalg import lstsq\ndef f(p,e):\n    return p[0]*(1-np.exp(-p[1]*e)) + p[2]*(1-np.exp(-p[3]*e))\np=np.array([4.6572,1.2078,21.395,0.14496])\n# fit with 4 params via simple LM\nfor it in range(200):\n    r=sigma-f(p,eps)\n    J=np.c_[1-np.exp(-p[1]*eps), p[0]*eps*np.exp(-p[1]*eps), 1-np.exp(-p[3]*eps), p[2]*eps*np.exp(-p[3]*eps)]\n    d=lstsq(J,r,rcond=None)[0]\n    p=p+0.5*d\nprint(p, np.mean(r**2)/np.var(sigma))\nc=np.corrcoef\nprint(\"corr resid-T\",c(r,T)[0,1],\"resid-eps\",c(r,eps)[0,1], \"resid-eps^2\", c(r,eps**2)[0,1])\no=np.argsort(eps)\nprint(np.round(np.c_[eps[o],r[o]][::15],3).tolist())", "out": "[ 4.65721885  1.20778801 21.39521966  0.14496047] 2.223375988562214e-06\ncorr resid-T 0.009173921068851643 resid-eps -0.10931535704727967 resid-eps^2 -0.06381812690630866\n[[0.216, 0.014], [0.433, 0.009], [0.711, -0.001], [0.906, -0.006], [1.108, -0.008], [1.457, -0.006], [1.708, -0.002], [1.974, 0.002], [2.216, 0.004], [2.379, 0.005], [2.618, 0.005], [2.779, 0.005], [3.056, 0.002], [3.28, -0.0], [3.469, -0.002], [3.695, -0.005], [4.017, -0.006], [4.286, -0.006], [4.427, -0.004], [4.8, 0.004]]\n"}
{"t": 1795078029.3416538, "tool": "analyze", "code": "B=np.c_[np.ones_like(eps),T,T**2,eps,eps*T,eps**2,eps**2*T,np.log(eps),np.log(eps)*T, 1/T, eps/T]\nco=lstsq(B,r,rcond=None)[0]\nprint(np.round(co,5))\nprint(\"explained frac\", 1-np.mean((r-B@co)**2)/np.mean(r**2))\n# residual vs T binned\nfor t0 in np.arange(2,6,0.5):\n    m=(T>=t0)&(T<t0+0.5)\n    print(t0, m.sum(), np.round(r[m].mean(),4), np.round(r[m].std(),4))", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 5, in <module>\nNameError: name 'lstsq' is not defined\n"}
