{"t": 1795078830.4305882, "tool": "analyze", "code": "import itertools\nns=[0.5,1,1.5,2,2.5,3]\nps=[0,0.5,1,1.5,2,2.5,3,3.5,4]\nbasis={}\nfor n in ns:\n  for p in ps:\n    basis[(p,n)]=(T**p)*(eps**n)\nkeys=list(basis)\n# greedy forward selection up to 4 terms\nsel=[]\nfor step in range(4):\n    bestr=None\n    for k in keys:\n        if k in sel: continue\n        X=np.c_[[basis[j] for j in sel+[k]]].T\n        c,_,_,_=np.linalg.lstsq(X,sigma,rcond=None)\n        r=np.mean((X@c-sigma)**2)/np.var(sigma)\n        if bestr is None or r<bestr[0]: bestr=(r,k,c)\n    sel.append(bestr[1]); print(step,bestr[0],sel,np.round(bestr[2],4))\n", "out": "0 0.07270679998244911 [(1, 1)] [0.5747]\n1 0.05031124107403534 [(1, 1), (4, 0.5)] [0.4891 0.0014]\n2 0.02633701165113468 [(1, 1), (4, 0.5), (0, 2.5)] [0.2803 0.0027 0.0812]\n3 0.014808744616979171 [(1, 1), (4, 0.5), (0, 2.5), (1.5, 0.5)] [-0.0848  0.002   0.1376  0.2677]\n"}
