{"t": 1795078815.7256386, "tool": "analyze", "code": "from itertools import combinations\nL=np.log(T); E=eps\ncands={}\nfor p in [0,1,2,3,4]:\n  for name,f in [('e',E),('e2',E**2),('e05',E**0.5),('e15',E**1.5),('e3',E**3),('ex',np.exp(0.3*E)-1),('lnE',np.log(E)),('E_lnE',E*np.log(E))]:\n    cands[f'T^{p}*{name}']=(T**p)*f\nnames=list(cands)\nbest=[]\nfor a,b in combinations(names,2):\n    X=np.c_[cands[a],cands[b]]\n    c,_,_,_=np.linalg.lstsq(X,sigma,rcond=None)\n    r=np.mean((X@c-sigma)**2)/np.var(sigma)\n    best.append((r,a,b,c))\nbest.sort(key=lambda x:x[0])\nfor x in best[:8]: print(x)\n", "out": "(np.float64(0.017500664275607047), 'T^0*e3', 'T^2*e05', array([0.05417125, 0.15884943]))\n(np.float64(0.021040081497020927), 'T^0*ex', 'T^3*e05', array([2.2477809 , 0.02401354]))\n(np.float64(0.02131561591248), 'T^0*e2', 'T^3*e05', array([0.31695855, 0.02554746]))\n(np.float64(0.025356760615176294), 'T^0*e2', 'T^2*e05', array([0.25369019, 0.14549229]))\n(np.float64(0.026147673354569065), 'T^0*ex', 'T^4*e05', array([2.5580114 , 0.00411815]))\n(np.float64(0.026548345868514425), 'T^0*e15', 'T^3*e05', array([0.65956634, 0.02399812]))\n(np.float64(0.031400740860711665), 'T^0*e15', 'T^4*e05', array([0.75166806, 0.00411006]))\n(np.float64(0.03221430001978521), 'T^1*ex', 'T^2*e05', array([0.62473211, 0.09119467]))\n"}
