{"t": 1795090798.8083696, "tool": "analyze", "code": "import numpy as np\nt=df['t'].values; A=df['A'].values; y=df['dA_dt'].values\nfor lo in np.arange(0.5,10,1.0):\n    m=(t>=lo)&(t<lo+1.0)\n    if m.sum()<8: continue\n    c=np.polyfit(A[m],y[m],3)\n    r=y[m]-np.polyval(c,A[m])\n    print(f\"t[{lo:.1f},{lo+1:.1f}) n={m.sum()} c3..c0={np.round(c,3)} rms={np.sqrt(np.mean(r**2)):.3f}\")\n# check t-dependence at fixed-ish A via linear fit of y on 1/t, t, t^2 etc\nprint(np.corrcoef(A,y)[0,1], np.corrcoef(t,y)[0,1])\n", "out": "t[0.5,1.5) n=29 c3..c0=[  1.074  -7.169  16.189 -22.463] rms=2.109\nt[1.5,2.5) n=33 c3..c0=[ -0.255   1.331   0.314 -10.334] rms=0.586\nt[2.5,3.5) n=45 c3..c0=[-0.259  1.387  0.393 -9.524] rms=0.219\nt[3.5,4.5) n=33 c3..c0=[-0.364  2.008 -0.41  -9.217] rms=0.127\nt[4.5,5.5) n=33 c3..c0=[ -0.273   1.526   0.567 -10.012] rms=0.146\nt[5.5,6.5) n=35 c3..c0=[ -0.286   1.669   0.386 -10.429] rms=0.086\nt[6.5,7.5) n=18 c3..c0=[-0.51   3.311 -2.74  -9.688] rms=0.249\nt[7.5,8.5) n=20 c3..c0=[ -0.54    3.527  -2.959 -10.487] rms=0.272\nt[8.5,9.5) n=37 c3..c0=[ -0.612   4.031  -3.613 -11.9  ] rms=0.366\nt[9.5,10.5) n=17 c3..c0=[ -0.72    4.749  -4.838 -12.356] rms=0.283\n0.8318260726765305 0.19996900713990592\n"}
{"t": 1795090809.2496479, "tool": "analyze", "code": "import numpy as np\nt=df['t'].values; A=df['A'].values; y=df['dA_dt'].values\ndef fit(feats,names):\n    X=np.column_stack(feats)\n    c,res,rk,sv=np.linalg.lstsq(X,y,rcond=None)\n    r=y-X@c\n    nmse=np.mean(r**2)/np.var(y)\n    return nmse,c\ntf={'1':np.ones_like(t),'t':t,'t2':t**2,'1/t':1/t,'exp(-t)':np.exp(-t),'lnt':np.log(t)}\nfor Ai in [2,3,4]:\n    for tn in [['1','t','1/t'],['1','t','t2','1/t'],['1','t','t2','1/t','exp(-t)'],['1','t','1/t','lnt','exp(-t)']]:\n        feats=[];names=[]\n        for i in range(Ai):\n            for n in tn:\n                feats.append(A**i*tf[n]); names.append(f\"A^{i}*{n}\")\n        nmse,c=fit(feats,names)\n        print(Ai,tn,f\"nmse={nmse:.3e}\")\n", "out": "2 ['1', 't', '1/t'] nmse=2.565e-02\n2 ['1', 't', 't2', '1/t'] nmse=1.801e-02\n2 ['1', 't', 't2', '1/t', 'exp(-t)'] nmse=1.793e-02\n2 ['1', 't', '1/t', 'lnt', 'exp(-t)'] nmse=1.814e-02\n3 ['1', 't', '1/t'] nmse=2.293e-02\n3 ['1', 't', 't2', '1/t'] nmse=1.452e-02\n3 ['1', 't', 't2', '1/t', 'exp(-t)'] nmse=1.444e-02\n3 ['1', 't', '1/t', 'lnt', 'exp(-t)'] nmse=1.472e-02\n4 ['1', 't', '1/t'] nmse=8.873e-03\n4 ['1', 't', 't2', '1/t'] nmse=2.081e-03\n4 ['1', 't', 't2', '1/t', 'exp(-t)'] nmse=1.995e-03\n4 ['1', 't', '1/t', 'lnt', 'exp(-t)'] nmse=2.313e-03\n"}
