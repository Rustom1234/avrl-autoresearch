{"t": 1795096629.3355649, "tool": "analyze", "code": "import numpy.linalg as la\ndef fit(tb, ei=(1,2,3)):\n    cols=[]\n    for i in ei:\n        for f in tb:\n            cols.append(eps**i*f)\n    A=np.array(cols).T\n    c,_,_,_=la.lstsq(A,sigma,rcond=None)\n    return np.sqrt(np.mean((A@c-sigma)**2)), c\nprint(fit([T**0,T,T**2]))\nprint(fit([T**0,T,T**2,1/T]))\nprint(fit([T**0,T,np.log(T)]))\nprint(fit([T**0,T**-1,T**-2]))\nprint(fit([T**0,np.exp(-T),np.exp(-2*T)]))\nprint(fit([T**0,T,T**2],ei=(1,2,3,4)))\n", "out": "(np.float64(0.08164748764808662), array([-2.85615135e+00, -1.33338528e-01,  1.31508325e-02,  1.64031012e+00,\n       -4.27672752e-01,  2.16196852e-02, -1.35423444e-01,  3.28891293e-02,\n       -1.76165567e-03]))\n(np.float64(0.07221973077643101), array([-2.82581772e+00, -1.49448061e-01,  1.45026627e-02,  6.00054678e-02,\n        9.44282028e-01, -2.33321948e-01,  5.07990756e-03,  7.28495454e-01,\n       -6.25667820e-02,  1.24992523e-02, -5.12044503e-05, -7.33519851e-02]))\n(np.float64(0.07286324176521801), array([-2.87200758,  0.07336994, -0.42997655,  1.43776204, -0.09637301,\n       -0.56201935, -0.11512438,  0.00548459,  0.04448849]))\n(np.float64(0.1200220969935543), array([-3.01119374, -1.31164508,  2.32130752, -1.37028969,  8.70360947,\n       -8.42560139,  0.10496457, -0.74548333,  0.75873338]))\n(np.float64(0.44026523906927), array([-3.06693544e+00, -9.88619818e+00,  6.80765745e+01, -1.71080478e-01,\n        2.52363211e+01, -1.30197539e+02,  1.04673128e-02, -2.70426680e+00,\n        1.52088604e+01]))\n(np.float64(0.05568022833747632), array([-2.92250225e+00, -3.62949871e-02,  1.52628038e-02,  1.78537841e+00,\n       -5.96661903e-01,  2.72580790e-02, -1.95290725e-01,  9.96677360e-02,\n       -4.93000837e-03,  6.94695861e-03, -7.54139837e-03,  3.99880034e-04]))\n"}
