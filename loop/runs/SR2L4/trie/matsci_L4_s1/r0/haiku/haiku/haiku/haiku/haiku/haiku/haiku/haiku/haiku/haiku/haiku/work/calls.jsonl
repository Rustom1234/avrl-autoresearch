{"t": 1795091026.0268743, "tool": "analyze", "code": "import numpy as np\nT=df['T'].values;e=df['eps'].values;s=df['sigma'].values\nres=[]\nfor lo in np.arange(2,6,0.4):\n    m=(T>=lo)&(T<lo+0.4)\n    if m.sum()<10: continue\n    best=None\n    for k in np.linspace(-1,3,401):\n        X=np.c_[-e[m]*np.exp(-k*e[m]), -e[m]**2*np.exp(-k*e[m])]\n        c,*_=np.linalg.lstsq(X,s[m],rcond=None)\n        r=np.sum((X@c-s[m])**2)\n        if best is None or r<best[0]: best=(r,k,c)\n    # also plain quadratic-in-eps no exp\n    X=np.c_[-e[m],-e[m]**2,-e[m]**3]\n    c3,*_=np.linalg.lstsq(X,s[m],rcond=None)\n    r3=np.sum((X@c3-s[m])**2)\n    print(round(lo+0.2,2), m.sum(), 'exp fit k=',round(best[1],3),'coef',np.round(best[2],3),'rss',f\"{best[0]:.2e}\", 'poly3 rss',f\"{r3:.2e}\", np.round(c3,3))", "out": "2.2 30 exp fit k= 0.38 coef [3.186 0.223] rss 2.47e+00 poly3 rss 2.39e+00 [ 3.128 -0.85   0.072]\n2.6 31 exp fit k= 0.15 coef [2.737 0.012] rss 3.76e+00 poly3 rss 2.98e+00 [ 3.107 -0.672  0.065]\n3.0 40 exp fit k= 0.11 coef [2.784 0.006] rss 2.83e+00 poly3 rss 2.54e+00 [ 2.995 -0.449  0.037]\n3.4 24 exp fit k= 0.09 coef [2.951 0.014] rss 1.12e+00 poly3 rss 1.07e+00 [ 3.076 -0.34   0.024]\n3.8 20 exp fit k= 0.04 coef [2.852 0.01 ] rss 2.11e+00 poly3 rss 1.67e+00 [ 3.269 -0.392  0.046]\n4.2 36 exp fit k= 0.0 coef [ 2.785 -0.009] rss 2.17e+00 poly3 rss 1.59e+00 [ 3.241 -0.29   0.04 ]\n4.6 32 exp fit k= -0.01 coef [2.897 0.004] rss 1.96e+00 poly3 rss 1.31e+00 [ 3.379 -0.286  0.048]\n5.0 33 exp fit k= -0.02 coef [2.994 0.005] rss 1.18e+00 poly3 rss 9.74e-01 [ 3.242 -0.097  0.024]\n5.4 26 exp fit k= 0.04 coef [3.081 0.25 ] rss 8.24e-01 poly3 rss 8.26e-01 [ 3.088  0.12  -0.006]\n5.8 28 exp fit k= -0.04 coef [ 3.212 -0.014] rss 1.24e+00 poly3 rss 1.23e+00 [3.247 0.092 0.005]\n"}
