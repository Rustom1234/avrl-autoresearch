{"t": 1795091046.93929, "tool": "analyze", "code": "import numpy as np\nT=df['T'].values;e=df['eps'].values;s=df['sigma'].values\np=[1.8644,1.7053,-0.66767,0.81705,0.038994,-0.29816,0.16945,0.058028,-1.4797,0.23613]\na,b,c,d,f,g,h,k,m,n=p\nnum=a+b/T+(c+d*np.sqrt(T)+m/T)*e\nden=1+(k+f/T)*e+n*e**2\npred=-e*num*np.exp(-(g+h/T)*e)/den\nr=s-pred\nprint('nmse',np.mean(r**2)/np.var(s))\nfor name,x in [('eps',e),('T',T)]:\n    qs=np.quantile(x,np.linspace(0,1,7))\n    out=[]\n    for i in range(6):\n        m_=(x>=qs[i])&(x<=qs[i+1])\n        out.append((round(qs[i],2), round(np.mean(r[m_]),4), round(np.std(r[m_]),4)))\n    print(name,out)\nprint('resid vs sigma corr', np.corrcoef(r,pred)[0,1])", "out": "nmse 3.0363349537447614e-05\neps [(np.float64(0.2), np.float64(0.0053), np.float64(0.0232)), (np.float64(0.99), np.float64(-0.005), np.float64(0.0264)), (np.float64(1.69), np.float64(-0.0001), np.float64(0.0217)), (np.float64(2.6), np.float64(0.0025), np.float64(0.0149)), (np.float64(3.3), np.float64(0.0039), np.float64(0.0261)), (np.float64(4.14), np.float64(-0.0035), np.float64(0.0238))]\nT [(np.float64(2.0), np.float64(0.0066), np.float64(0.0283)), (np.float64(2.7), np.float64(-0.001), np.float64(0.0223)), (np.float64(3.18), np.float64(-0.0069), np.float64(0.02)), (np.float64(4.04), np.float64(-0.0067), np.float64(0.0139)), (np.float64(4.62), np.float64(0.0029), np.float64(0.0144)), (np.float64(5.24), np.float64(0.0082), np.float64(0.0307))]\nresid vs sigma corr 0.029757967217057375\n"}
