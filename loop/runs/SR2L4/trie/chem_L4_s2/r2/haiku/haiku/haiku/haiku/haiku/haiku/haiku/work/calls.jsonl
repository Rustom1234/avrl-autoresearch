{"t": 1795092683.1166277, "tool": "analyze", "code": "def nmse(f,p0s):\n    best=None\n    for p0 in p0s:\n        try:\n            r=least_squares(lambda p: f(p)-dA_dt, p0, max_nfev=3000)\n            if best is None or r.cost<best.cost: best=r\n        except Exception as e: pass\n    return np.mean(best.fun**2)/np.var(dA_dt), best.x\nrs=np.random.RandomState(1)\nP0=[rs.uniform(-1,2,6) for _ in range(40)]\nf1=lambda p: -p[0]*t**p[1]/(1+p[2]*A**2) + p[3]*A**p[4]*t**p[5]\nprint(nmse(f1,P0))\nf2=lambda p: -p[0]*t**p[1]*np.exp(-p[2]*A**2) + p[3]*A**p[4]*t**p[5]\nprint(nmse(f2,P0))\nf3=lambda p: -p[0]*t**p[1]*np.exp(-p[2]*A**2)*(1) + p[3]*A**p[4]*t**p[5]*np.exp(-p[6]*t)\nprint(nmse(f3,[np.r_[q,rs.uniform(-1,1)] for q in P0]))\n", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 15, in <module>\n  File \"<string>\", line 11, in nmse\nAttributeError: 'NoneType' object has no attribute 'fun'\n"}
