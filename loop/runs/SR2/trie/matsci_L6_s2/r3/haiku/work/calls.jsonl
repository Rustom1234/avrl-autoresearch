{"t": 1795087800.4684079, "tool": "analyze", "code": "from scipy.optimize import curve_fit\ndef f(e,c,n,d): return c*e**n+d\nfor lo in [2.0,2.5,3.0,3.5,4.0,4.5,5.0,5.5]:\n    m=(T>=lo)&(T<lo+0.5)\n    try:\n        p,_=curve_fit(f,eps[m],sigma[m],p0=[1,1,0],maxfev=20000)\n        r=np.std(sigma[m]-f(eps[m],*p))/np.std(sigma[m])\n        print(lo,m.sum(),np.round(p,4),round(r,5))\n    except Exception as ex: print(lo,ex)", "out": "2.0 34 [ 0.9789  1.2545 -0.0825] 0.07096\n2.5 27 [0.7745 1.4424 0.4029] 0.0693\n3.0 47 [0.7258 1.5387 0.8093] 0.08107\n3.5 39 [0.7414 1.5574 1.2969] 0.09859\n4.0 44 [0.801  1.6119 1.7817] 0.10312\n4.5 39 [0.6289 1.8474 2.7356] 0.09424\n5.0 37 [0.5116 2.0256 3.8715] 0.11875\n5.5 33 [0.5896 1.9837 5.06  ] 0.12727\n"}
{"t": 1795087804.7307265, "tool": "analyze", "code": "fams={\n 'pow':lambda e,c,n: c*e**n,\n 'exp':lambda e,c,b: c*(np.exp(b*e)-1),\n 'sat':lambda e,c,b,n: c*(1-np.exp(-b*e))*e**n,\n 'lud_exp':lambda e,c,b,d: c*e**b*np.exp(d*e),\n}\nfor lo in [2.0,3.0,4.0,5.0]:\n    m=(T>=lo)&(T<lo+0.5)\n    out=[]\n    for k,fn in fams.items():\n        try:\n            p0=[1,1,1] if k!='pow' else [1,1]\n            if k=='lud_exp': p0=[1,1,0.1]\n            p,_=curve_fit(fn,eps[m],sigma[m],p0=p0,maxfev=20000)\n            r=np.std(sigma[m]-fn(eps[m],*p))/np.std(sigma[m])\n            out.append((k,np.round(p,3).tolist(),round(r,4)))\n        except Exception as ex: out.append((k,str(ex)[:40]))\n    print(lo,out)\n# also: check whether sigma^(1/T) or log slope structure: ln sigma vs ln T at fixed eps\n", "out": "2.0 [('pow', \"name 'curve_fit' is not defined\"), ('exp', \"name 'curve_fit' is not defined\"), ('sat', \"name 'curve_fit' is not defined\"), ('lud_exp', \"name 'curve_fit' is not defined\")]\n3.0 [('pow', \"name 'curve_fit' is not defined\"), ('exp', \"name 'curve_fit' is not defined\"), ('sat', \"name 'curve_fit' is not defined\"), ('lud_exp', \"name 'curve_fit' is not defined\")]\n4.0 [('pow', \"name 'curve_fit' is not defined\"), ('exp', \"name 'curve_fit' is not defined\"), ('sat', \"name 'curve_fit' is not defined\"), ('lud_exp', \"name 'curve_fit' is not defined\")]\n5.0 [('pow', \"name 'curve_fit' is not defined\"), ('exp', \"name 'curve_fit' is not defined\"), ('sat', \"name 'curve_fit' is not defined\"), ('lud_exp', \"name 'curve_fit' is not defined\")]\n"}
