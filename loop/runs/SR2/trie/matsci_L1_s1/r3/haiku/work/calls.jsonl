{"t": 1795089470.3687263, "tool": "analyze", "code": "import itertools\nfeats={'1':np.ones_like(eps),'T':T,'e':eps,'Te':T*eps,'e2':eps**2,'T2':T**2,'le':np.log(eps),'lT':np.log(T),'sqe':np.sqrt(eps),'e_inv':1/eps,'T_e_inv':T/eps,'T2e':T**2*eps,'Te2':T*eps**2,'e3':eps**3,'T3':T**3,'eT2':eps*T**2}\nnames=list(feats)\nbest=[]\nfor k in [2,3,4]:\n    for c in itertools.combinations(names,k):\n        if '1' not in c: continue\n        X=np.c_[[feats[n] for n in c]].T\n        b,res,*_=np.linalg.lstsq(X,sigma,rcond=None)\n        r=sigma-X@b\n        best.append((np.mean(r**2)/np.var(sigma),c,b.round(3)))\nbest.sort(key=lambda x:x[0])\nfor x in best[:8]: print(x)\n", "out": "(np.float64(5.8880505391198674e-24), ('1', 'e', 'T2', 'T2e'), array([ 0.   , -1.21 ,  0.184,  0.   ]))\n(np.float64(5.8880505391198674e-24), ('1', 'e', 'T2', 'eT2'), array([ 0.   , -1.21 ,  0.184,  0.   ]))\n(np.float64(5.889877659438691e-24), ('1', 'e', 'T2', 'Te2'), array([ 0.   , -1.21 ,  0.184,  0.   ]))\n(np.float64(5.8899694888472065e-24), ('1', 'e', 'T2', 'sqe'), array([ 0.   , -1.21 ,  0.184, -0.   ]))\n(np.float64(5.8900204563661745e-24), ('1', 'e', 'T2', 'le'), array([-0.   , -1.21 ,  0.184, -0.   ]))\n(np.float64(5.892028009385618e-24), ('1', 'e', 'T2', 'e_inv'), array([-0.   , -1.21 ,  0.184,  0.   ]))\n(np.float64(5.892043466149814e-24), ('1', 'e', 'T2', 'T3'), array([ 0.   , -1.21 ,  0.184,  0.   ]))\n(np.float64(5.89211075867295e-24), ('1', 'e', 'Te', 'T2'), array([-0.   , -1.21 ,  0.   ,  0.184]))\n"}
