{"t": 1795081720.9634824, "tool": "analyze", "code": "import numpy as np\nL=np.log(P)\nbase={'1':np.ones_like(t),'t':t,'P':P,'PL':P*L,'L':L,'1/P':1/P,'P2':P**2,'P15':P**1.5,'tP15':t*P**1.5,'tP':t*P,'t2P15':t**2*P**1.5,'tL':t*L,'tPL':t*P*L,'t2':t**2,'tP2':t*P**2,'t2P':t**2*P,'P2L':P**2*L,'t/P':t/P,'tP05':t*P**0.5,'P05':P**0.5}\ndef fit(keys):\n    A=np.column_stack([base[k] for k in keys])\n    c=np.linalg.lstsq(A,dP_dt,rcond=None)[0]\n    r=dP_dt-A@c\n    return np.mean(r**2)/np.var(dP_dt),c\nfor keys in [['1','t','P','PL','L','1/P','P2','P15'],['1','t','P','PL','L','1/P','P2','P15','tP15'],['1','t','P','PL','L','1/P','P15','tP15','tP'],['1','t','P','PL','L','1/P','P15','tP15','tP','t2P15'],['1','t','P','PL','L','1/P','P15','tP15','tP','tPL'],['1','t','P','PL','L','1/P','P2','P15','tP15','tP','t2P15']]:\n    e,c=fit(keys); print(keys[-3:],e,np.round(c,4))\n", "out": "['1/P', 'P2', 'P15'] 0.03976069539690055 [-162.1302    0.7206   18.7313 -172.3541  -97.9274  -13.1398  -14.0512\n  176.0764]\n['P2', 'P15', 'tP15'] 0.006054359262952722 [ 1.65114e+01  4.65700e-01 -7.63280e+00  4.98350e+00  3.06510e+00\n  3.62400e-01  1.59000e-02 -2.09020e+00  3.84000e-02]\n['P15', 'tP15', 'tP'] 0.006052298581156328 [ 1.63118e+01  4.70500e-01 -7.58230e+00  4.80670e+00  2.96480e+00\n  3.47200e-01 -1.91760e+00  4.06000e-02 -5.90000e-03]\n['tP15', 'tP', 't2P15'] 2.323440888741005e-07 [ 1.68101e+01  4.69800e-01 -8.03920e+00  5.13590e+00  3.36650e+00\n  4.25500e-01 -1.96790e+00 -0.00000e+00  1.00000e-04  3.00000e-03]\n['tP15', 'tP', 'tPL'] 0.006044959944637193 [ 1.62685e+01  4.99500e-01 -7.72430e+00  4.59750e+00  3.03370e+00\n  3.48800e-01 -1.71030e+00 -5.00000e-04  2.90000e-03  4.81000e-02]\n['tP15', 'tP', 't2P15'] 1.949695938915692e-08 [ 1.27976e+01  4.70000e-01 -7.78560e+00  9.43000e-01  1.15740e+00\n  1.44200e-01 -3.64300e-01  2.43330e+00 -0.00000e+00  0.00000e+00\n  3.10000e-03]\n"}
