{"t": 1795081705.294127, "tool": "analyze", "code": "import numpy as np\nL=np.log(P)\ndef fit(cols,names):\n    A=np.column_stack(cols)\n    c,res,_,_=np.linalg.lstsq(A,dP_dt,rcond=None)\n    r=dP_dt-A@c\n    print('NMSE',np.mean(r**2)/np.var(dP_dt))\n    return c,r\ncols=[np.ones_like(t),t,P,P*L,L,1/P,P**2,P**3,t**2*P**1.5,t**2*P**2,t*L,t**2,t*P,t*P*L,t**2*P]\nnames=['1','t','P','PL','L','1/P','P2','P3','t2P1.5','t2P2','tL','t2','tP','tPL','t2P']\nc,r=fit(cols,names)\nprint(dict(zip(names,np.round(c,4))))\n# residual vs t and P correlation\nprint(np.corrcoef(r,t)[0,1], np.corrcoef(r,P)[0,1])\nfor lo,hi in [(0.5,2),(2,4),(4,6),(6,8),(8,10),(10,12)]:\n    m=(t>=lo)&(t<hi); print(lo,hi,np.round(np.mean(r[m]),3),np.round(np.std(r[m]),3))\nfor lo,hi in [(0.3,0.8),(0.8,1.5),(1.5,2.5),(2.5,4),(4,6)]:\n    m=(P>=lo)&(P<hi); print(lo,hi,np.round(np.mean(r[m]),3),np.round(np.std(r[m]),3))\n", "out": "NMSE 3.040093865819142e-08\n{'1': np.float64(14.1559), 't': np.float64(0.4696), 'P': np.float64(-7.0723), 'PL': np.float64(2.7075), 'L': np.float64(1.8074), '1/P': np.float64(0.2109), 'P2': np.float64(-0.065), 'P3': np.float64(-0.0037), 't2P1.5': np.float64(0.0031), 't2P2': np.float64(-0.0), 'tL': np.float64(0.0), 't2': np.float64(0.0), 'tP': np.float64(0.0003), 'tPL': np.float64(-0.0001), 't2P': np.float64(-0.0)}\n-3.276375380695216e-13 2.7373811298055138e-11\n0.5 2 -0.0 0.0\n2 4 -0.0 0.001\n4 6 0.0 0.0\n6 8 0.0 0.001\n8 10 -0.0 0.0\n10 12 -0.0 0.001\n0.3 0.8 -0.0 0.001\n0.8 1.5 0.0 0.001\n1.5 2.5 0.0 0.0\n2.5 4 -0.0 0.0\n4 6 0.0 0.0\n"}
