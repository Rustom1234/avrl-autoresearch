{"t": 1795086885.9928777, "tool": "analyze", "code": "g=[np.ones_like(t),t,t**2,np.sqrt(t),np.exp(-t),np.exp(-0.5*t),np.log(t),1/(t+1)]\ncols=[]\nfor f in g:\n    for p in [np.ones_like(P),P,P**2]:\n        cols.append(f*p)\nA=np.array(cols).T\nb=np.linalg.lstsq(A,dP_dt,rcond=None)[0]\nprint(np.std(dP_dt-A@b)/np.std(dP_dt))\n# try subsets: P^k * (1 - exp) forms\nfor name,ff in [('1-exp(-t)',1-np.exp(-t)),('1-exp(-.5t)',1-np.exp(-0.5*t)),('t/(1+t)',t/(1+t)),('sqrt',np.sqrt(t)),('tanh',np.tanh(t))]:\n    A2=np.c_[ff,ff*P,ff*P**2,P,P**2,np.ones_like(P)]\n    b2=np.linalg.lstsq(A2,dP_dt,rcond=None)[0]\n    print(name,np.std(dP_dt-A2@b2)/np.std(dP_dt),np.round(b2,3))", "out": "0.1008164526514228\n1-exp(-t) 0.4231452990634897 [-10.333  -2.292   0.729   1.174  -0.552   4.348]\n1-exp(-.5t) 0.24670668562701334 [-8.167 -1.382  0.542  0.252 -0.339  1.592]\nt/(1+t) 0.2779956490866944 [-11.618  -2.094   0.806   0.772  -0.526   3.922]\nsqrt 0.3947781199054229 [-2.348 -0.255  0.143 -0.284 -0.218  0.062]\ntanh 0.5845580169831968 [-10.546  -3.067   0.825   1.952  -0.658   4.85 ]\n"}
{"t": 1795086889.951067, "tool": "evaluate", "code": "def equation(t,P,params):\n    s=1-np.exp(-params[1]*t**params[2])\n    return -params[0]*s + params[3]*P + params[4]*P**2 + params[5]*P*s + params[6]*P**2*s", "out": "{\"ok\": true, \"train_nmse\": 0.05030420429279151, \"params\": [6.637090670537289, 0.24161101205011531, 1.3797858611183575, -0.23232128070741956, -0.1972540471147367, -0.8752443340675827, 0.39843550470423605, 1.0, 1.0, 1.0], \"evals\": {}}"}
{"t": 1795086894.3267674, "tool": "analyze", "code": "best=None\nfor k in [0.1,0.2,0.3,0.5,0.7,1.0]:\n  for pw in [0.5,0.75,1,1.5]:\n    s=1-np.exp(-k*t**pw)\n    cols=[np.ones_like(P),P,P**2,P**3]+[s*P**j for j in range(0,4)]\n    A=np.array(cols).T\n    b=np.linalg.lstsq(A,dP_dt,rcond=None)[0]\n    e=np.std(dP_dt-A@b)/np.std(dP_dt)\n    if best is None or e<best[0]: best=(e,k,pw,np.round(b,3))\nprint(best)\n# residual of simple linear-in-P-with-s model vs P\ns=1-np.exp(-0.2*t**1.4)\nA=np.array([np.ones_like(P),P,P**2,P**3,s,s*P,s*P**2,s*P**3]).T\nb=np.linalg.lstsq(A,dP_dt,rcond=None)[0]; r=dP_dt-A@b\nprint(np.std(r)/np.std(dP_dt), np.round(b,3))\nprint(np.corrcoef(np.c_[r,t,P,t**2,P**2].T)[0])", "out": "(np.float64(0.2125407859667704), 0.2, 1.5, array([-0.713,  0.259, -0.351,  0.016, -6.379, -0.587,  0.253,  0.016]))\n0.21772615791478192 [-0.838  0.337 -0.387  0.02  -6.443 -0.632  0.282  0.013]\n[1.00000000e+00 3.26527812e-01 2.68863016e-14 4.51576368e-01\n 3.98191042e-14]\n"}
{"t": 1795086901.2372308, "tool": "analyze", "code": "best=None\nfor k in np.linspace(0.15,0.4,26):\n    s=np.tanh(k*t)\n    A=np.array([np.ones_like(P),P,P**2,s,s*P,s*P**2]).T\n    b=np.linalg.lstsq(A,dP_dt,rcond=None)[0]\n    e=np.std(dP_dt-A@b)/np.std(dP_dt)\n    if best is None or e<best[0]: best=(e,k,np.round(b,4))\nprint(best)\ne,k,_=best\ns=np.tanh(k*t)\nA=np.array([np.ones_like(P),P,P**2,s,s*P,s*P**2]).T\nb=np.linalg.lstsq(A,dP_dt,rcond=None)[0]; r=dP_dt-A@b\nprint(np.corrcoef(np.c_[r,t,P,s].T)[0])", "out": "(np.float64(0.22577497752229475), np.float64(0.28), array([ 0.3326, -0.0345, -0.2477, -7.0208, -1.0921,  0.4547]))\n[ 1.00000000e+00  2.65517430e-01 -7.80747595e-15 -3.78402982e-15]\n"}
