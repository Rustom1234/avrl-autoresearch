{"t": 1795087393.5338037, "tool": "analyze", "code": "import itertools\nfeats={}\nbases={'1':np.ones_like(eps),'e':eps,'e2':eps**2,'e3':eps**3,'1/e':1/eps,'1/e2':1/eps**2,'le':np.log(eps),'T':T,'T2':T**2,'1/T':1/T,'lT':np.log(T),'eT':eps*T,'e2T':eps**2*T,'e/T':eps/T,'lT_e':np.log(T)*eps,'exp-e':np.exp(-eps),'sqrte':np.sqrt(eps),'T/e':T/eps,'eT2':eps*T**2,'e2T2':eps**2*T**2}\nnames=list(bases)\nbest=[]\nfor k in range(1,6):\n    for comb in itertools.combinations(names,k):\n        X=np.c_[[bases[c] for c in comb]].T\n        c,res,rk,_=np.linalg.lstsq(X,sigma,rcond=None)\n        r=sigma-X@c\n        nmse=np.mean(r**2)/np.var(sigma)\n        best.append((nmse,comb))\nbest.sort()\nfor b in best[:12]: print(b)", "out": "(np.float64(0.0008145238429744176), ('e', '1/e', '1/T', 'e2T', 'lT_e'))\n(np.float64(0.0013550438137663135), ('e', '1/e', 'e2T', 'lT_e', 'sqrte'))\n(np.float64(0.0016899214490858554), ('1', 'e', '1/e', 'e2T', 'lT_e'))\n(np.float64(0.001894446301812322), ('e', '1/e2', 'le', 'e2T', 'lT_e'))\n(np.float64(0.001987817449518234), ('e', '1/e', 'e2T', 'e/T', 'sqrte'))\n(np.float64(0.0020927236296566843), ('e', 'le', 'exp-e', 'eT2', 'e2T2'))\n(np.float64(0.0021929358728346345), ('le', 'e2T', 'lT_e', 'exp-e', 'sqrte'))\n(np.float64(0.0023092400339737216), ('1/e', '1/T', 'e2T', 'e/T', 'lT_e'))\n(np.float64(0.002319746276344706), ('1/e', 'T2', 'sqrte', 'eT2', 'e2T2'))\n(np.float64(0.0023437486148263163), ('1', '1/e', 'e2T', 'lT_e', 'sqrte'))\n(np.float64(0.002474436600760217), ('1/e', 'e2T', 'e/T', 'lT_e', 'sqrte'))\n(np.float64(0.002528766720665577), ('1', '1/e2', 'e2T', 'lT_e', 'sqrte'))\n"}
{"t": 1795087402.1178257, "tool": "analyze", "code": "from scipy.optimize import least_squares\nfams={\n 'A':lambda p: p[0]/eps+p[1]*np.log(eps)+p[2]+p[3]*T*eps**2+p[4]*T*eps+p[5]*T,\n 'B':lambda p: p[0]*np.exp(-p[1]*eps)+p[2]+p[3]*eps+p[4]*T*eps**2+p[5]*T*eps,\n 'C':lambda p: p[0]/eps**p[1]+p[2]+p[3]*eps**2+p[4]*T*eps**p[5],\n 'D':lambda p: p[0]*np.log(eps)+p[1]*eps+p[2]+p[3]*T*eps**p[4]+p[5]*T,\n 'E':lambda p: (p[0]+p[1]*T)/eps**p[2]+p[3]+p[4]*eps+p[5]*T*eps**2,\n}\nfor k,f in fams.items():\n    bestr=None\n    for s in range(15):\n        p0=np.random.RandomState(s).randn(6)\n        try:\n            r=least_squares(lambda p: f(p)-sigma, p0)\n            if bestr is None or r.cost<bestr.cost: bestr=r\n        except Exception as ex: pass\n    print(k, np.mean(bestr.fun**2)/np.var(sigma), np.round(bestr.x,4))", "out": "A 0.009044849205285508 [ 0.2967 -5.8694 -2.2316  0.0871  0.0202 -0.1077]\nB 0.005716805181434433 [16.8812  3.4599  0.8133 -2.903   0.1716 -0.3202]\nC 0.002533736120917015 [  9.2398   0.4859 -11.1024  -0.2586   0.024    2.9259]\nD 0.009316744720276049 [-5.9843 -0.2134 -1.4016  0.0954  2.0172 -0.1428]\nE 0.0073376638884065475 [ 17.8032  -0.1559   0.2867 -18.5235  -1.0312   0.0976]\n"}
{"t": 1795087407.9703004, "tool": "analyze", "code": "Eb={'1':np.ones_like(eps),'e':eps,'e2':eps**2,'e3':eps**3,'1/e':1/eps,'le':np.log(eps),'e4':eps**4}\nTb={'1':np.ones_like(T),'T':T,'T2':T**2,'T3':T**3,'1/T':1/T}\nimport itertools\ncols=[];nm=[]\nfor a in Eb:\n    for b in Tb:\n        cols.append(Eb[a]*Tb[b]); nm.append(a+'*'+b)\nX=np.c_[cols].T\nc,*_=np.linalg.lstsq(X,sigma,rcond=None)\nr=sigma-X@c\nprint(np.mean(r**2)/np.var(sigma))\n# sparse selection: greedy backward\nsel=list(range(len(nm)))\ndef score(s):\n    Xs=X[:,s]; cc,*_=np.linalg.lstsq(Xs,sigma,rcond=None); return np.mean((sigma-Xs@cc)**2)\nwhile len(sel)>1:\n    scs=[(score([x for x in sel if x!=d]),d) for d in sel]\n    s,d=min(scs)\n    sel.remove(d)\n    print(round(s/np.var(sigma),8), [nm[i] for i in sel])\n    if s/np.var(sigma)>0.5: break", "out": "3', 'e4*1/T']\n2.1e-07 ['1*T', '1*T2', '1*T3', '1*1/T', 'e*1', 'e*T', 'e*T2', 'e*T3', 'e*1/T', 'e2*T', 'e2*T2', 'e2*T3', 'e2*1/T', 'e3*1', 'e3*T', 'e3*T2', 'e3*T3', '1/e*1', '1/e*T', '1/e*T3', '1/e*1/T', 'le*1', 'le*T', 'le*T3', 'le*1/T', 'e4*1', 'e4*T', 'e4*T2', 'e4*T3']\n2.3e-07 ['1*T2', '1*T3', '1*1/T', 'e*1', 'e*T', 'e*T2', 'e*T3', 'e*1/T', 'e2*T', 'e2*T2', 'e2*T3', 'e2*1/T', 'e3*1', 'e3*T', 'e3*T2', 'e3*T3', '1/e*1', '1/e*T', '1/e*T3', '1/e*1/T', 'le*1', 'le*T', 'le*T3', 'le*1/T', 'e4*1', 'e4*T', 'e4*T2', 'e4*T3']\n2.5e-07 ['1*T2', '1*T3', '1*1/T', 'e*1', 'e*T', 'e*T2', 'e*T3', 'e*1/T', 'e2*T', 'e2*T2', 'e2*T3', 'e2*1/T', 'e3*1', 'e3*T', 'e3*T2', 'e3*T3', '1/e*1', '1/e*T', '1/e*T3', 'le*1', 'le*T', 'le*T3', 'le*1/T', 'e4*1', 'e4*T', 'e4*T2', 'e4*T3']\n2.6e-07 ['1*T2', '1*T3', '1*1/T', 'e*1', 'e*T', 'e*T2', 'e*T3', 'e*1/T', 'e2*T', 'e2*T2', 'e2*T3', 'e2*1/T', 'e3*1', 'e3*T', 'e3*T2', 'e3*T3', '1/e*1', '1/e*T3', 'le*1', 'le*T', 'le*T3', 'le*1/T', 'e4*1', 'e4*T', 'e4*T2', 'e4*T3']\n2.6e-07 ['1*T2', '1*T3', '1*1/T', 'e*1', 'e*T', 'e*T2', 'e*T3', 'e*1/T', 'e2*T', 'e2*T2', 'e2*T3', 'e2*1/T', 'e3*1', 'e3*T', 'e3*T2', 'e3*T3', '1/e*1', 'le*1', 'le*T',