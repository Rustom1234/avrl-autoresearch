{"t": 1795084682.7258124, "tool": "analyze", "code": "def R2(cols):\n    X=np.column_stack(cols)\n    c,_,_,_=np.linalg.lstsq(X,dP_dt,rcond=None)\n    r=dP_dt-X@c\n    return 1-np.sum(r**2)/np.sum((dP_dt-dP_dt.mean())**2), c\none=np.ones_like(t)\ntb=[one,t,t**2,t**3]\npb=[one,P,P**2,P**3]\ncols=[a*b for a in tb for b in pb]\nprint('cubic-cubic',R2(cols)[0])\ncols2=[a*b for a in [one,t,t**2,t**3,np.log(t),np.sqrt(t)] for b in [one,P,P**2]]\nprint('mixed',R2(cols2)[0])\n# P-only dependence check: with t-bases\ncols3=[a*b for a in [one,t,t**2] for b in [one,P,P**2,P**3,1/(P+1)]]\nprint('ratio P',R2(cols3)[0])\ncols4=[a*b for a in [one,t,t**2,t**3] for b in [one,P,P**2]]+[np.exp(-P)*one, np.exp(-P)*t]\nprint('exp',R2(cols4)[0])", "out": "cubic-cubic 0.9893573048072808\nmixed 0.9832008422741073\nratio P 0.9939670717152518\nexp 0.986149009039328\n"}
{"t": 1795084691.332247, "tool": "analyze", "code": "base=[one,t,P,t*P,P**2,t*P**2,t**2]\nbest=None\nfor g in np.linspace(-0.5,2,101):\n    den=1+g*P\n    X=np.column_stack([b for b in base])\n    # rate*den = X c  -> rate = X c/den\n    A=X/den[:,None]\n    c,_,_,_=np.linalg.lstsq(A,dP_dt,rcond=None)\n    r=dP_dt-A@c\n    R=1-np.sum(r**2)/np.sum((dP_dt-dP_dt.mean())**2)\n    if best is None or R>best[0]: best=(R,g,c)\nprint('rational',best[0],best[1],np.round(best[2],3))\n# log P term\nfor extra in [np.log(P), np.log(P)*t, P*np.log(P), np.exp(-t/3)*P]:\n    print(R2(base+[extra])[0])", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 4, in <module>\nNameError: name 'one' is not defined. Did you mean: 'None'?\n"}
