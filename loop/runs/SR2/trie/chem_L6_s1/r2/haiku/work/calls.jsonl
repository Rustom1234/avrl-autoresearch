{"t": 1795085470.962688, "tool": "analyze", "code": "one=np.ones_like(t)\ndef fitc(names_pows):\n    cols=[(t**q)*(A**p) for p,q in names_pows]\n    X=np.column_stack(cols)\n    c,_,_,_=np.linalg.lstsq(X,dA_dt,rcond=None)\n    r=dA_dt-X@c\n    return np.mean(r**2)/np.var(dA_dt), c\nfor P in [[(0,0),(1,0),(-1,0),(-1,1),(0,1),(1,1),(0,2),(-1,2)],\n          [(0,0),(1,0),(-1,0),(-1,1),(0,1),(1,1),(0,2),(-1,2),(2,0),(2,1)],\n          [(0,0),(1,0),(-1,0),(-2,0),(-1,1),(-2,1),(0,1),(1,1),(0,2),(-1,2),(-2,2)],\n          [(0,0),(1,0),(-1,0),(-1,1),(-1,2),(-2,0),(-2,1),(-2,2),(1,1),(1,2),(0,1),(0,2)]]:\n    e,c=fitc(P); print(round(e,6), np.round(c,3).tolist())", "out": "0.015028 [0.747, 1.358, -0.087, -0.273, 0.009, -0.005, -0.093, 0.066]\n0.001136 [-1.928, 3.544, 0.66, -0.321, 0.077, -0.057, -0.092, 0.068, -0.439, 0.01]\n0.006619 [2.817, 0.873, -2.057, 0.437, -0.193, -0.029, -0.096, 0.022, -0.094, 0.069, 0.0]\n0.006399 [3.686, 0.65, -2.765, 0.198, 0.03, 0.576, -0.106, 0.008, 0.141, -0.011, -0.564, -0.048]\n"}
{"t": 1795085474.0646276, "tool": "analyze", "code": "best=[]\nfor w in np.arange(0.05,3.0,0.01):\n  for fam in ['cos','sincos']:\n    cols=[]\n    for p in [-1,0,1,2]:\n        cols.append(A**p)\n        cols.append(A**p*np.cos(w*t))\n        cols.append(A**p*np.sin(w*t))\n    X=np.column_stack(cols)\n    c,_,_,_=np.linalg.lstsq(X,dA_dt,rcond=None)\n    r=dA_dt-X@c\n    best.append((np.mean(r**2)/np.var(dA_dt),w))\n    break\nbest.sort(); print(best[:5])", "out": "[(np.float64(0.0009020471253082942), np.float64(0.13)), (np.float64(0.0009026771802674013), np.float64(0.14)), (np.float64(0.0009107407761108714), np.float64(0.12000000000000001)), (np.float64(0.0009151393521224682), np.float64(0.15000000000000002)), (np.float64(0.0009264953666592395), np.float64(0.11000000000000001))]\n"}
{"t": 1795085480.377028, "tool": "analyze", "code": "cands={}\nfor p in [-3,-2,-1.5,-1,-0.5,0,0.5,1,1.5,2,3]:\n    for q in [0,1,2,3]:\n        cands[(p,q)]=(A**p)*(t**q)\nfor name,f in [('exp(-t)',np.exp(-t)),('exp(-t/2)',np.exp(-t/2)),('lnA',np.log(A)),('exp(-A)',np.exp(-A)),('1/(1+A)',1/(1+A)),('expt/A',np.exp(-t)/A)]:\n    cands[(name,0)]=f\n    cands[(name,1)]=f*t\nsel=[]\nkeys=list(cands)\nfor step in range(7):\n    bestk=None;beste=9\n    for k in keys:\n        if k in sel: continue\n        X=np.column_stack([np.ones_like(t)]+[cands[s] for s in sel]+[cands[k]])\n        c,_,_,_=np.linalg.lstsq(X,dA_dt,rcond=None)\n        e=np.mean((dA_dt-X@c)**2)/np.var(dA_dt)\n        if e<beste: beste=e;bestk=k\n    sel.append(bestk); print(step,bestk,round(beste,6))", "out": "0 (0, 2) 0.385566\n1 (1.5, 0) 0.202373\n2 (-1, 3) 0.045913\n3 (2, 0) 0.000604\n4 (3, 0) 0.00037\n5 ('1/(1+A)', 0) 8e-06\n6 (-3, 0) 6e-06\n"}
