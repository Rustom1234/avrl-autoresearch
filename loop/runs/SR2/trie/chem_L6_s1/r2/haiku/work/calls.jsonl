{"t": 1795085442.5696542, "tool": "analyze", "code": "import numpy as np\n# try r = dA/A^n vs t for several n; check how well a function of t alone fits\nfor n in [0,1,2]:\n    y=dA_dt/A**n\n    # fit y ~ polynomial in t and A-independent? check residual of smooth fit in t\n    X=np.column_stack([np.ones_like(t),t,t**2,t**3,t**4,t**5])\n    c,res,_,_=np.linalg.lstsq(X,y,rcond=None)\n    r=y-X@c\n    print(n, np.mean(r**2)/np.var(y))\n# sort by t, print a 1-D sample for A-binned\nfor lo in [0.2,1,2,3]:\n    m=(A>lo)&(A<lo+0.3)\n    o=np.argsort(t[m])\n    print(lo, np.round(np.column_stack([t[m][o],dA_dt[m][o]])[::max(1,m.sum()//12)],2).tolist())", "out": "0 0.3827717925488309\n1 0.8962126220266836\n2 0.9817249673577526\n0.2 [[0.61, 0.37], [1.71, -0.04], [2.16, -0.14], [2.76, -0.21], [3.99, -0.46], [5.28, 0.14], [5.9, -0.04], [6.15, -0.78], [6.91, 2.71], [7.41, 3.75], [8.04, 1.07], [8.92, 0.36]]\n1 [[1.16, 1.95], [1.86, 1.72], [3.28, 0.86], [3.69, 0.99], [4.11, 0.39], [4.6, 0.11], [4.91, -0.18], [5.67, -0.42], [6.11, -0.61], [6.48, -1.07], [7.85, -1.94], [8.23, -2.3], [8.57, -2.54], [9.87, -3.31]]\n2 [[0.95, 3.68], [1.87, 3.35], [3.01, 3.05], [3.32, 2.85], [4.19, 2.52], [4.48, 2.12], [4.87, 1.7], [5.0, 1.58], [6.05, 0.9], [6.36, 0.61], [7.09, -0.21], [7.24, -0.35], [7.69, -0.7], [7.84, -0.86], [7.85, -1.0], [7.92, -1.06], [8.7, -1.78], [8.99, -2.23], [9.18, -2.5], [9.85, -3.22]]\n3 [[0.71, 4.97], [0.95, 4.87], [1.13, 4.73], [1.55, 4.67], [1.97, 4.53], [2.15, 4.58], [3.78, 3.63], [4.38, 3.35], [4.57, 3.07], [5.56, 2.19], [6.44, 1.35], [6.98, 0.8], [7.27, 0.59], [7.34, 0.51], [7.9, -0.26], [8.33, -0.82], [8.53, -1.05], [8.54, -1.05], [9.18, -1.85], [9.27, -2.0], [9.61, -2.41], [9.74, -2.68]]\n"}
